# Docker-specific environment variables
# Database URLs use 'postgres' hostname (Docker service name)
DATABASE_URL="postgresql://pericles_user:pericles_dev_password@postgres:5432/pericles?schema=public"
MASTRA_DATABASE_URL="postgresql://pericles_user:pericles_dev_password@postgres:5432/mastra?schema=public"

# Redis uses 'redis' hostname (Docker service name)
REDIS_URL=redis://redis:6379

# AI Model Provider (loaded from host .env via docker-compose)
# OPENAI_API_KEY is passed through docker-compose

# News & Social Media APIs (passed via docker-compose environment)
# THENEWSAPI_API_KEY - from host environment
# TWITTERAPIIO_API_KEY - from host environment

# Weather API (passed via docker-compose environment)
# OPENWEATHER_API_KEY - from host environment

# SAP S/4HANA Cloud Integration
SAP_S4HANA_BASE_URL=https://mock-sap.s4hana.ondemand.com
SAP_S4HANA_CLIENT_ID=mock-client-id
SAP_S4HANA_CLIENT_SECRET=mock-client-secret
SAP_S4HANA_TIMEOUT=30000
SAP_S4HANA_USE_MOCK=true

# Monitoring Configuration
MONITORING_DEFAULT_INTERVAL_MS=15000
LOG_LEVEL=info
ENABLE_TRACING=true
