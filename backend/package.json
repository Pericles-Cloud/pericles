{
  "name": "mastra-agents",
  "version": "0.0.1",
  "description": "Pericles Supply Chain Risk Management Platform",
  "main": "index.js",
  "scripts": {
    "test": "vitest",
    "test:run": "vitest run",
    "test:ci": "vitest run --reporter=junit --outputFile=test-results.xml",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --watch",
    "dev": "dotenv -e ../.env.local -- mastra dev",
    "dev:auth": "dotenv -e ../.env.local -- tsx watch src/server/auth-server.ts",
    "dev:all": "concurrently --kill-others -n mastra,auth -c blue,green \"PORT=4111 npm run dev\" \"npm run dev:auth\"",
    "build": "dotenv -e ../.env.local -- mastra build",
    "start": "dotenv -e ../.env.local -- mastra start",
    "monitoring:start": "dotenv -e ../.env.local -- node dist/monitoring/start.js",
    "prisma:generate": "dotenv -e ../.env.local -- prisma generate",
    "prisma:migrate:dev": "dotenv -e ../.env.local -- prisma migrate dev",
    "prisma:migrate:deploy": "dotenv -e ../.env.local -- prisma migrate deploy",
    "prisma:seed": "dotenv -e ../.env.local -- prisma db seed",
    "prisma:studio": "dotenv -e ../.env.local -- prisma studio",
    "mock:create": "dotenv -e ../.env.local -- tsx src/scripts/mocker/index.ts create",
    "mock:reset": "dotenv -e ../.env.local -- tsx src/scripts/mocker/index.ts reset",
    "mock:status": "dotenv -e ../.env.local -- tsx src/scripts/mocker/index.ts status",
    "mock:help": "dotenv -e ../.env.local -- tsx src/scripts/mocker/index.ts help",
    "jobs:cleanup": "dotenv -e ../.env.local -- tsx src/jobs/data-retention-cleanup.ts",
    "bol:seed": "dotenv -e ../.env.local -- tsx src/scripts/seed-bol-context.ts",
    "lint": "eslint . --ext ts,tsx",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "lint:strict": "eslint . --ext ts,tsx --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pretype-check": "node scripts/fix-mastra-provider-types.mjs",
    "type-check": "tsc --noEmit",
    "fix:mastra-provider-types": "node scripts/fix-mastra-provider-types.mjs",
    "lint-staged": "lint-staged",
    "postinstall": "node scripts/fix-mastra-provider-types.mjs",
    "prepare": "node -e \"try { require('husky') } catch (e) { process.exit(0) }\" && husky install || true"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@mastra/core": "^0.24.8",
    "@mastra/evals": "^0.14.4",
    "@mastra/libsql": "^0.16.4",
    "@mastra/loggers": "^0.10.19",
    "@mastra/memory": "^0.15.13",
    "@mastra/pg": "^0.17.10",
    "@prisma/client": "^6.12.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "csv-parse": "^6.1.0",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "google-auth-library": "^10.5.0",
    "jsonwebtoken": "^9.0.3",
    "pino": "^9.0.0",
    "pino-pretty": "^11.0.0",
    "socket.io": "^4.8.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.0.1",
    "@vercel/node": "^5.5.16",
    "@vitest/coverage-v8": "^4.1.7",
    "concurrently": "^9.2.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.18.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11",
    "mastra": "^0.18.8",
    "prettier": "^3.4.2",
    "prisma": "^6.12.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.19.1",
    "vitest": "^4.1.7"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
