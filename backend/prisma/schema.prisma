// Prisma Schema for Pericles Monitoring Agent
// Database: PostgreSQL 16 (Docker local) / Neon serverless (production)

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ORGANIZATION MODEL (Root entity for multi-tenancy)
// Supports hierarchical organizations with parent-child relationships
// Root organization (Pericles, Inc.) owns all child organizations
// ============================================================================
model Organization {
  id                        String   @id @default(uuid())
  name                      String
  email_domains             String[] @default([]) // Domains for auto-assignment (e.g., ["pericles.cloud", "pericles.ai"])
  is_root                   Boolean  @default(false)

  // Hierarchical organization structure
  parent_organization_id    String?
  parent_organization       Organization?  @relation("OrganizationHierarchy", fields: [parent_organization_id], references: [id], onDelete: SetNull)
  child_organizations       Organization[] @relation("OrganizationHierarchy")

  // Company details
  address_line1             String?
  city                      String?
  state                     String?
  zip_code                  String?
  country                   String?
  phone_number              String?
  website                   String?
  most_recent_shipment_date DateTime?
  database_updated_date     DateTime?
  customer_type             String?

  created_at                DateTime @default(now())
  updated_at                DateTime @updatedAt

  // Relations
  events              Event[]
  incidents           Incident[]
  riskAssessments     RiskAssessment[]
  eventHashes         EventHash[]
  context             OrganizationContext?
  settings            OrganizationSettings?
  toolConfigs         DataSourceToolConfig[]
  suppliers           Supplier[]
  shipments           Shipment[]
  users               UserOrganization[]
  workflows           Workflow[]

  @@index([is_root])
  @@index([parent_organization_id])
}

// ============================================================================
// ORGANIZATION SETTINGS (Organization-level configuration)
// ============================================================================
model OrganizationSettings {
  id                    String   @id @default(uuid())
  organization_id       String   @unique
  organization          Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  // Agent Settings
  monitoring_agent_enabled       Boolean  @default(true)
  monitoring_polling_interval_ms Int      @default(15000)
  monitoring_enabled_sources     Json     @default("{\"weather\":true,\"political\":true,\"cybersecurity\":true,\"economic\":true,\"news\":true,\"maritime\":true,\"labor\":true,\"regulatory\":true,\"pandemic\":true,\"geopolitical\":true}")

  // AI Settings
  ai_model_provider      String   @default("openai")
  ai_model_name          String   @default("gpt-4o")
  ai_model_temperature   Float    @default(0.7)
  ai_max_tokens          Int      @default(4096)

  // Notification Settings
  notifications_email_enabled    Boolean  @default(true)
  notifications_email_recipients Json     @default("[]")
  notifications_severity_threshold Float  @default(0.7)
  notifications_slack_enabled    Boolean  @default(false)
  notifications_slack_webhook_url String?
  notifications_digest_enabled   Boolean  @default(true)
  notifications_digest_frequency String   @default("weekly")

  // Integration Status
  integration_sap_configured     Boolean  @default(false)
  integration_sap_last_sync      DateTime?
  integration_sap_sync_frequency String   @default("daily")

  // Data Retention
  retention_events_days      Int      @default(365)
  retention_audit_logs_days  Int      @default(90)
  retention_incidents_days   Int      @default(730)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([organization_id])
}

// ============================================================================
// DATA SOURCE TOOL CONFIG (Per-tool configuration for monitoring agents)
// ============================================================================
model DataSourceToolConfig {
  id                String   @id @default(uuid())
  organization_id   String
  organization      Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  // Tool identification
  data_source       String   // weather, political, cybersecurity, economic, news, maritime, labor, regulatory, pandemic, geopolitical
  tool_id           String   // noaa, eonet, gdelt, nvd, cisa, fred, thenewsapi, twitter, rss feeds, etc.
  tool_name         String   // Human-readable name: "NOAA Weather API", "NASA EONET"

  // Common settings
  enabled           Boolean  @default(true)
  api_timeout_ms    Int      @default(15000)
  severity_threshold Float   @default(0.5)  // 0.0-1.0 (low=0.3, medium=0.5, high=0.7)
  lookback_hours    Int      @default(24)

  // Tool-specific configuration (flexible JSON)
  // Examples:
  // - RSS tools: { "feed_urls": ["https://..."], "max_items": 50 }
  // - GDELT tools: { "search_terms": ["strike", "protest"], "country_filters": ["US", "CN"] }
  // - API tools: { "api_key_env": "NOAA_API_KEY", "base_url": "https://..." }
  // - Weather: { "proximity_radius_km": 500, "min_magnitude": 4.0 }
  config            Json     @default("{}")

  // API credentials (optional override)
  api_key_encrypted String?  // Encrypted API key for this specific tool
  api_key_env_var   String?  // Environment variable name for API key

  // Metadata
  description       String?  @db.Text
  documentation_url String?
  last_success_at   DateTime?
  last_error_at     DateTime?
  last_error_message String? @db.Text
  total_events_fetched Int   @default(0)

  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  @@unique([organization_id, data_source, tool_id])
  @@index([organization_id, data_source])
  @@index([organization_id, enabled])
}

// ============================================================================
// ORGANIZATION CONTEXT (ERP and configuration data)
// ============================================================================
model OrganizationContext {
  id                    String   @id @default(uuid())
  organization_id       String   @unique
  organization          Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  // ERP-synced data (JSON for flexibility)
  plants                Json     // Array of plant objects with locations
  warehouses            Json     // Array of warehouse objects
  suppliers             Json     // Array of supplier objects
  shipping_lanes        Json     // Array of shipping lane objects

  // Risk monitoring preferences
  monitored_risk_types  String[] // e.g., ["flood", "strike", "port_closure"]
  geographic_radius_km  Float    @default(100)
  severity_threshold    Float    @default(0.5)

  // Business documents metadata
  strategic_documents   Json?    // References to annual plans, risk policies, etc.

  last_erp_sync         DateTime?
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt

  @@index([organization_id])
}

// ============================================================================
// EVENT MODEL (Raw detected events before validation)
// ============================================================================
model Event {
  id                String   @id @default(uuid())
  organization_id   String
  organization      Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  // Event identification
  event_hash        String   // Stable content hash for deduplication
  type              String   // incident category: flood, strike, port_closure, etc.
  source            String   // Data source: news_api, weather_api, port_feed, etc.

  // Event details
  title             String
  description       String   @db.Text

  // Location (optional)
  location_name     String?
  latitude          Float?
  longitude         Float?

  // Temporal
  detected_at       DateTime @default(now())
  event_timestamp   DateTime // When the event actually occurred/was reported

  // Risk scoring
  severity          Float    // 0.0 - 1.0
  confidence        Float    // 0.0 - 1.0
  risk_factors      String[] // e.g., ["high_impact", "cascading_risk"]
  affected_domains  String[] // e.g., ["manufacturing", "logistics"]

  // Validation workflow
  validation_status String   @default("pending") // pending, validated, rejected, duplicate
  validated_at      DateTime?

  // Raw data preservation
  raw_data          Json?    // Original API response for audit trail

  // Relations
  incident          Incident?
  riskAssessment    RiskAssessment?

  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  @@unique([organization_id, event_hash])
  @@index([organization_id, validation_status])
  @@index([organization_id, event_timestamp])
  @@index([event_hash])
  @@index([type])
  @@index([source])
}

// ============================================================================
// INCIDENT MODEL (Validated events promoted to incidents)
// ============================================================================
model Incident {
  id                String   @id @default(uuid())
  organization_id   String
  organization      Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  // Source event
  event_id          String   @unique
  event             Event    @relation(fields: [event_id], references: [id], onDelete: Cascade)

  // Incident metadata
  incident_number   String   @unique // Human-readable: INC-2025-0001
  status            String   @default("open") // open, investigating, resolved, closed
  priority          String   // critical, high, medium, low

  // Assignment and workflow
  assigned_to       String?  // User ID
  assigned_at       DateTime?
  resolved_at       DateTime?
  closed_at         DateTime?

  // Impact tracking
  estimated_impact  Float?   // Financial impact in USD
  actual_impact     Float?
  impact_calculated_at DateTime?

  // Response tracking
  response_plan_id  String?  // Link to Plans module
  notifications_sent Int     @default(0)

  // Multi-source validation
  confirming_sources String[] // Additional sources that validated this incident
  validation_count   Int      @default(1)

  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  @@index([organization_id, status])
  @@index([organization_id, priority])
  @@index([incident_number])
  @@index([created_at])
}

// ============================================================================
// RISK ASSESSMENT MODEL (Agent-generated risk analysis)
// ============================================================================
model RiskAssessment {
  id                String   @id @default(uuid())
  organization_id   String
  organization      Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  // Source event
  event_id          String   @unique
  event             Event    @relation(fields: [event_id], references: [id], onDelete: Cascade)

  // Assessment scores
  severity_score    Float    // 0.0 - 1.0 (normalized)
  confidence_score  Float    // 0.0 - 1.0

  // Risk classification
  risk_category     String   // operational, financial, reputational, compliance
  risk_type         String   // specific type: flood, strike, etc.

  // Impact analysis
  geographic_impact Json     // Affected regions, entities
  supply_chain_impact Json   // Affected plants, suppliers, lanes
  financial_impact_estimate Float?

  // Reasoning
  risk_factors      String[] // Contributing factors
  affected_domains  String[] // Business domains affected
  mitigation_suggestions String[] // AI-generated recommendations

  // Assessment metadata
  assessed_by       String   @default("monitoring_agent") // agent name or user_id
  assessment_model  String   @default("claude-sonnet-4-5") // Model used

  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  @@index([organization_id, risk_category])
  @@index([organization_id, severity_score])
  @@index([event_id])
}

// ============================================================================
// EVENT HASH MODEL (Deduplication tracking)
// ============================================================================
model EventHash {
  id                String   @id @default(uuid())
  organization_id   String
  organization      Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  hash              String   // SHA-256 hash of normalized event content

  // Tracking
  first_seen_at     DateTime @default(now())
  last_seen_at      DateTime @default(now())
  occurrence_count  Int      @default(1)

  // Reference to original event
  original_event_id String

  // Expiration for bounded lookback window
  expires_at        DateTime // TTL for hash (e.g., 7 days)

  @@unique([organization_id, hash])
  @@index([organization_id, expires_at])
  @@index([hash])
}

// ============================================================================
// MONITORING AUDIT LOG (Observability and debugging)
// ============================================================================
model MonitoringAuditLog {
  id                String   @id @default(uuid())
  organization_id   String?  // Nullable for system-wide events

  // Event details
  event_type        String   // monitoring_cycle, source_fetch, deduplication, error
  source            String?  // Which data source
  status            String   // success, failure, partial

  // Metrics
  events_detected   Int      @default(0)
  events_filtered   Int      @default(0)
  events_published  Int      @default(0)
  duplicates_found  Int      @default(0)

  // Performance
  duration_ms       Int?

  // Error tracking
  error_message     String?  @db.Text
  error_stack       String?  @db.Text

  // Context
  metadata          Json?    // Additional structured data

  created_at        DateTime @default(now())

  @@index([organization_id, created_at])
  @@index([event_type])
  @@index([status])
}

// ============================================================================
// SUPPLIER MODEL (Levi Strauss supplier data)
// ============================================================================
model Supplier {
  id                  String   @id
  organization_id     String
  organization        Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  // Supplier details
  name                String
  address             String?  @db.Text
  website             String?
  contact_info        String?  @db.Text
  country             String?
  country_code        String?
  latitude            Float?
  longitude           Float?

  // Shipping data
  total_shipments     Int      @default(0)
  destination_ports   String[]
  departure_ports     String[]
  hs_codes            String[]

  // Notify party
  notify_party_name    String?  @db.Text
  notify_party_address String?  @db.Text

  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  // Relations
  shipments           Shipment[]

  @@index([organization_id])
  @@index([country_code])
  @@index([name])
}

// ============================================================================
// CARRIER MODEL (Shipping carriers from BOLs)
// ============================================================================
model Carrier {
  id                String   @id
  scac_code         String   @unique
  name              String
  total_shipments   Int      @default(0)

  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  // Relations
  shipments         Shipment[]

  @@index([scac_code])
  @@index([name])
}

// ============================================================================
// SHIPMENT MODEL (Bill of Lading data)
// ============================================================================
model Shipment {
  id                      String   @id
  organization_id         String
  organization            Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  supplier_id             String?
  supplier                Supplier? @relation(fields: [supplier_id], references: [id], onDelete: SetNull)

  carrier_id              String?
  carrier                 Carrier? @relation(fields: [carrier_id], references: [id], onDelete: SetNull)

  // BOL details
  bol_number              String
  master_bol_number       String?
  containers_count        Int?
  shipping_route          String?  @db.Text

  // Financial
  value_usd               Float?

  // Dates
  arrival_date            DateTime?
  estimated_arrival_date  DateTime?

  // Ports
  destination_port        String?
  destination_port_code   String?
  departure_port          String?
  departure_port_code     String?
  last_visit_foreign_port String?

  // Vessel
  vessel_name             String?
  vessel_code             String?
  voyage                  String?

  // Containers
  container_ids           String[]
  container_sizes         String[]
  container_types         String[]

  // Products
  hs_codes                String[]
  hs_code_descriptions    String[]
  product_description     String?  @db.Text
  product_description_raw String?  @db.Text
  quantity                Float?
  quantity_unit           String?
  teu                     Float?
  weight                  Float?

  // Marks
  marks_numbers           String?  @db.Text
  marks_numbers_raw       String?  @db.Text

  // Notify party
  notify_party_name       String?  @db.Text
  notify_party_address    String?  @db.Text
  notify_party_country_code String?

  created_at              DateTime @default(now())
  updated_at              DateTime @updatedAt

  @@index([organization_id])
  @@index([supplier_id])
  @@index([carrier_id])
  @@index([bol_number])
  @@index([arrival_date])
  @@index([destination_port])
  @@index([departure_port])
}

// ============================================================================
// USER MODEL (Authentication entity)
// ============================================================================
model User {
  id                    String    @id @default(uuid())
  email                 String    @unique
  email_verified        Boolean   @default(false)
  email_verified_at     DateTime?

  // Password authentication (nullable for OAuth-only users)
  password_hash         String?

  // Google OAuth fields
  google_id             String?   @unique
  google_avatar_url     String?

  // Profile
  name                  String?
  avatar_url            String?

  // Status and security
  status                String    @default("active") // active, suspended, deleted
  last_login_at         DateTime?
  failed_login_attempts Int       @default(0)
  locked_until          DateTime?

  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt

  // Relations
  memberships           UserOrganization[]
  refresh_tokens        RefreshToken[]
  audit_logs            AuthAuditLog[]

  @@index([email])
  @@index([google_id])
  @@index([status])
}

// ============================================================================
// USER-ORGANIZATION RELATIONSHIP (Many-to-Many with role)
// ============================================================================
model UserOrganization {
  id              String       @id @default(uuid())
  user_id         String
  user            User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  organization_id String
  organization    Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  // Role within organization
  role            String       @default("MEMBER") // OWNER, ADMIN, MEMBER, GUEST

  // Invitation tracking
  invited_by      String?      // user_id of inviter
  invited_at      DateTime?
  accepted_at     DateTime?

  // Status
  status          String       @default("active") // active, pending, suspended

  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt

  @@unique([user_id, organization_id])
  @@index([user_id])
  @@index([organization_id])
  @@index([role])
}

// ============================================================================
// REFRESH TOKEN MODEL (For JWT token rotation)
// ============================================================================
model RefreshToken {
  id            String    @id @default(uuid())
  user_id       String
  user          User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  token_hash    String    @unique  // SHA-256 hash of token
  device_info   String?             // User agent / device identifier
  ip_address    String?

  expires_at    DateTime
  revoked_at    DateTime?
  revoked_reason String?

  created_at    DateTime  @default(now())

  @@index([user_id])
  @@index([token_hash])
  @@index([expires_at])
}

// ============================================================================
// AUTH AUDIT LOG MODEL (Security event tracking)
// ============================================================================
model AuthAuditLog {
  id              String    @id @default(uuid())
  user_id         String?
  user            User?     @relation(fields: [user_id], references: [id], onDelete: SetNull)
  organization_id String?

  // Event details
  event_type      String    // LOGIN, LOGOUT, LOGIN_FAILED, TOKEN_REFRESH, PASSWORD_RESET, etc.
  event_status    String    // SUCCESS, FAILURE

  // Request context
  ip_address      String?
  user_agent      String?

  // Additional data
  metadata        Json?     // Additional event-specific data
  error_message   String?

  created_at      DateTime  @default(now())

  @@index([user_id, created_at])
  @@index([organization_id, created_at])
  @@index([event_type])
  @@index([created_at])
}

// ============================================================================
// WORKFLOW BUILDER MODELS (Plans workflow builder for contingency planning)
// ============================================================================

model Workflow {
  id              String   @id @default(uuid())
  organization_id String
  organization    Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  name            String
  description     String?  @db.Text
  status          WorkflowStatus @default(DRAFT)
  version         Int      @default(1)

  // Viewport state for canvas persistence
  viewport_x      Float    @default(0)
  viewport_y      Float    @default(0)
  viewport_zoom   Float    @default(1)

  // Execution settings
  execution_mode  ExecutionMode @default(MANUAL)
  is_active       Boolean  @default(false)

  created_by      String
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  nodes           WorkflowNode[]
  edges           WorkflowEdge[]
  executions      WorkflowExecution[]

  @@unique([organization_id, name])
  @@index([organization_id])
  @@index([organization_id, status])
}

model WorkflowNode {
  id              String   @id @default(uuid())
  workflow_id     String
  workflow        Workflow @relation(fields: [workflow_id], references: [id], onDelete: Cascade)

  client_id       String   // UI library ID (e.g., "node-1")
  type            NodeType
  label           String?
  position_x      Float
  position_y      Float
  data            Json     @default("{}")  // Node-specific config

  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  outgoing_edges  WorkflowEdge[] @relation("SourceNode")
  incoming_edges  WorkflowEdge[] @relation("TargetNode")

  @@unique([workflow_id, client_id])
  @@index([workflow_id])
}

model WorkflowEdge {
  id              String   @id @default(uuid())
  workflow_id     String
  workflow        Workflow @relation(fields: [workflow_id], references: [id], onDelete: Cascade)

  client_id       String   // UI library ID (e.g., "edge-1-2")
  source_node_id  String
  source_node     WorkflowNode @relation("SourceNode", fields: [source_node_id], references: [id], onDelete: Cascade)
  target_node_id  String
  target_node     WorkflowNode @relation("TargetNode", fields: [target_node_id], references: [id], onDelete: Cascade)

  source_handle   String?  // Handle identifier (e.g., "yes", "no" for conditions)
  target_handle   String?
  label           String?
  data            Json     @default("{}")

  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  @@unique([workflow_id, client_id])
  @@index([workflow_id])
  @@index([source_node_id])
  @@index([target_node_id])
}

model WorkflowExecution {
  id              String   @id @default(uuid())
  workflow_id     String
  workflow        Workflow @relation(fields: [workflow_id], references: [id], onDelete: Cascade)

  status          ExecutionStatus @default(PENDING)
  triggered_by    String?  // "manual", "trigger:incident", etc.
  started_at      DateTime?
  completed_at    DateTime?
  error           String?  @db.Text
  execution_log   Json     @default("[]")

  created_at      DateTime @default(now())

  @@index([workflow_id])
  @@index([workflow_id, status])
}

enum WorkflowStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ExecutionMode {
  MANUAL
  AUTOMATIC
  BOTH
}

enum NodeType {
  TRIGGER
  ACTION
  CONDITION
  NOTIFICATION
  END
}

enum ExecutionStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}
