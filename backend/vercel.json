{
  "buildCommand": "prisma generate",
  "outputDirectory": "public",
  "functions": {
    "api/monitoring/trigger-stream.ts": {
      "memory": 1024,
      "maxDuration": 300,
      "includeFiles": "src/**/*"
    },
    "api/monitoring/trigger.ts": {
      "memory": 1024,
      "maxDuration": 300,
      "includeFiles": "src/**/*"
    },
    "api/organizations/[id]/workflows/[workflowId]/run.ts": {
      "memory": 1024,
      "maxDuration": 60,
      "includeFiles": "src/**/*"
    },
    "api/**/*.ts": {
      "memory": 1024,
      "maxDuration": 60,
      "includeFiles": "src/**/*"
    }
  },
  "crons": [
    {
      "path": "/api/monitoring/trigger",
      "schedule": "*/1 * * * *"
    }
  ]
}
