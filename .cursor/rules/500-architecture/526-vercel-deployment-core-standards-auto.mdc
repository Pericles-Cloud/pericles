// Rollback strategy
// scripts/rollback.js
const { execSync } = require('child_process');

async function rollback(deploymentId) {
  try {
    console.log(`Rolling back to deployment: ${deploymentId}`);
    
    // Promote previous deployment
    execSync(`vercel promote ${deploymentId} --token=${process.env.VERCEL_TOKEN}`);
    
    // Verify rollback
    const response = await fetch('https://myapp.vercel.app/api/health');
    if (!response.ok) {
      throw new Error('Health check failed after rollback');
    }
    
    console.log('✅ Rollback successful');
    
    // Notify team
    await notifyTeam(`Rollback to ${deploymentId} completed successfully`);
    
  } catch (error) {
    console.error('❌ Rollback failed:', error);
    await notifyTeam(`Rollback failed: ${error.message}`);
    process.exit(1);
  }
}

