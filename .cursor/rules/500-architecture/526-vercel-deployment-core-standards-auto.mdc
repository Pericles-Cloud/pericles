        <example title="Serverless Function Optimization">
          <correct-example title="Optimized serverless function configuration" conditions="Building high-performance API functions" expected-result="Fast, efficient serverless functions with proper error handling" correctness-criteria="Optimized runtime settings, proper error handling, regional configuration, monitoring integration"><![CDATA[// api/users/[id].ts - Optimized serverless function
import type { VercelRequest, VercelResponse } from '@vercel/node';
import { PrismaClient } from '@prisma/client';

// Function configuration
export const config = {
  runtime: 'nodejs20.x',
  maxDuration: 10,
  memory: 1024,
  regions: ['iad1', 'sfo1', 'lhr1']
};

// Connection pooling for serverless
const prisma = new PrismaClient({
  datasources: {
    db: {
      url: process.env.DATABASE_URL
    }
  }
});

// Keep connection warm
const connectionPromise = prisma.$connect();

export default async function handler(req: VercelRequest, res: VercelResponse) {
  // Early return for CORS preflight
  if (req.method === 'OPTIONS') {
    res.setHeader('Access-Control-Allow-Origin', '*');
    res.setHeader('Access-Control-Allow-Methods', 'GET, POST, PUT, DELETE, OPTIONS');
    res.setHeader('Access-Control-Allow-Headers', 'Content-Type, Authorization');
    return res.status(200).end();
  }

  // Performance monitoring
  const startTime = Date.now();

  try {
    // Ensure connection is ready
    await connectionPromise;

    // Input validation
    const { id } = req.query;
    if (!id || typeof id !== 'string') {
      return res.status(400).json({
        error: 'INVALID_INPUT',
        message: 'User ID is required and must be a string'
      });
    }

    // Optimized database query
    const user = await prisma.user.findUnique({
      where: { id },
      select: {
        id: true,
        email: true,
        first_name: true,
        last_name: true,
        role: true,
        created_at: true
      }
    });

    if (!user) {
      return res.status(404).json({
        error: 'USER_NOT_FOUND',
        message: 'User not found'
      });
    }

    // Performance logging
    const duration = Date.now() - startTime;
    console.log(`User fetch completed in ${duration}ms`);

    // Structured response
    return res.status(200).json({
      success: true,
      data: user,
      meta: {
        requestId: req.headers['x-vercel-id'],
        duration: `${duration}ms`
      }
    });

  } catch (error) {
    const duration = Date.now() - startTime;
    
    // Error logging with context
    console.error('User fetch error:', {
      error: error.message,
      requestId: req.headers['x-vercel-id'],
      userId: req.query.id,
      duration: `${duration}ms`,
      stack: error.stack
    });

    // Structured error response
    return res.status(500).json({
      error: 'INTERNAL_SERVER_ERROR',
      message: 'An unexpected error occurred',
      meta: {
        requestId: req.headers['x-vercel-id'],
        duration: `${duration}ms`
      }
    });
  }
}

// Graceful shutdown
process.on('SIGTERM', async () => {
  await prisma.$disconnect();
});]]></correct-example>
