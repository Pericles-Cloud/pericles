  sessionId: string;
  
  /** Associated user */
  user: Omit<User, 'jwtSecureCode'>;
  
  /** Session creation time */
  createdAt: Date;
  
  /** Last activity time */
  lastActivity: Date;
  
  /** IP address of session */
