          <correct-example title="Secure Google OAuth 2.0 with TypeScript using Passport.js" conditions="Implementing Google OAuth authentication" expected-result="Type-safe Google OAuth integration with proper security validation" correctness-criteria="Uses official Google libraries, validates ID tokens, implements proper TypeScript types, and follows Google best practices"><![CDATA[import passport from 'passport';
import { Strategy as GoogleStrategy, Profile, VerifyCallback } from 'passport-google-oauth20';
import { OAuth2Client } from 'google-auth-library';
import type { Request, Response } from 'express';

interface GoogleProfile {
  googleId: string;
  email: string;
  name: string;
  picture?: string;
  verified_email: boolean;
}

interface GoogleOAuthUser {
  id: string;
  googleId: string;
  email: string;
  fullName: string;
  role: 'OWNER' | 'ADMIN' | 'MEMBER' | 'GUEST';
  accountStatus: 'ACTIVE' | 'PENDING' | 'SUSPENDED';
  jwtSecureCode: string;
}

class GoogleOAuthService {
  private readonly client: OAuth2Client;
  private readonly clientId: string;
  private readonly clientSecret: string;

  constructor() {
    this.clientId = process.env.GOOGLE_CLIENT_ID!;
    this.clientSecret = process.env.GOOGLE_CLIENT_SECRET!;
    
    if (!this.clientId || !this.clientSecret) {
      throw new Error('Google OAuth credentials must be configured');
    }
    
    this.client = new OAuth2Client(this.clientId);
  }

  // Passport.js strategy configuration
  createStrategy(): GoogleStrategy {
    return new GoogleStrategy(
      {
        clientID: this.clientId,
        clientSecret: this.clientSecret,
        callbackURL: `${process.env.BE_BASE_URL}/api/auth/google/callback`,
        scope: ['profile', 'email']
      },
      this.verifyCallback.bind(this)
    );
  }

  private async verifyCallback(
    accessToken: string,
    refreshToken: string,
    profile: Profile,
    done: VerifyCallback
  ): Promise<void> {
    try {
      // Validate the profile data
      if (!profile.emails?.[0]?.value || !profile.emails[0].verified) {
        return done(new Error('Email not verified'));
      }

      const email = profile.emails[0].value;
      const googleProfile: GoogleProfile = {
        googleId: profile.id,
        email,
        name: profile.displayName,
        picture: profile.photos?.[0]?.value,
        verified_email: profile.emails[0].verified
      };

      // Check if user exists or create new user
      let user = await this.findUserByGoogleId(profile.id);
      
      if (!user) {
        user = await this.createGoogleUser(googleProfile);
      }

      return done(null, user);
    } catch (error) {
      return done(error instanceof Error ? error : new Error('Google OAuth verification failed'));
    }
  }

  // Server-side ID token verification
  async verifyIdToken(idToken: string): Promise<GoogleProfile | null> {
    try {
      const ticket = await this.client.verifyIdToken({
        idToken,
        audience: this.clientId
      });

      const payload = ticket.getPayload();
      if (!payload || !payload.email_verified) {
        return null;
      }

      return {
        googleId: payload.sub,
        email: payload.email!,
        name: payload.name!,
        picture: payload.picture,
        verified_email: payload.email_verified
      };
    } catch (error) {
      console.error('ID token verification failed:', error);
      return null;
    }
  }

  private async findUserByGoogleId(googleId: string): Promise<GoogleOAuthUser | null> {
