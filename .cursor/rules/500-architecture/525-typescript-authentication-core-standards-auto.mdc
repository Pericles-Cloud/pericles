          <correct-example title="Comprehensive TypeScript interfaces with JSDoc documentation" conditions="Documenting authentication API interfaces" expected-result="Well-documented TypeScript interfaces for all authentication components" correctness-criteria="Includes JSDoc comments, comprehensive type definitions, clear interface exports, and usage examples"><![CDATA[/**
 * @fileoverview TypeScript interfaces and types for authentication system
 * @version 1.0.0
 * @author Authentication Team
 */

/**
 * User roles with hierarchical permissions
 * OWNER > ADMIN > MEMBER > GUEST
 */
export type UserRole = 'OWNER' | 'ADMIN' | 'MEMBER' | 'GUEST';

/**
 * Account status for user management
 */
export type AccountStatus = 'ACTIVE' | 'PENDING' | 'SUSPENDED' | 'DELETED';

/**
 * Email verification status
 */
export type EmailStatus = 'VERIFIED' | 'UNVERIFIED' | 'PENDING';

/**
 * Authentication provider types
 */
export type AuthProvider = 'local' | 'google' | 'github' | 'apple';

/**
 * Core user interface for authentication system
 * @interface User
 * @since 1.0.0
 */
export interface User {
  /** Unique user identifier */
  readonly id: string;
  
  /** User's email address (unique across system) */
  email: string;
  
  /** User's first name */
  firstName: string;
  
  /** User's last name */
  lastName: string;
  
  /** User's role determining permissions */
  role: UserRole;
  
  /** Current account status */
  accountStatus: AccountStatus;
  
  /** Email verification status */
  emailStatus: EmailStatus;
  
  /** Authentication provider used for account creation */
  provider: AuthProvider;
  
  /** Google OAuth ID (if applicable) */
  googleId?: string;
  
  /** Account creation timestamp */
  readonly createdAt: Date;
  
  /** Last account update timestamp */
  readonly updatedAt: Date;
  
  /** Last login timestamp */
  lastLoginAt?: Date;
  
  /** JWT secure code for token validation (internal use) */
  readonly jwtSecureCode: string;
}

/**
 * Authentication request payload for login
 * @interface LoginRequest
 * @since 1.0.0
 */
export interface LoginRequest {
  /** User's email address */
  email: string;
  
  /** User's password */
  password: string;
  
  /** Optional remember me flag for extended session */
  rememberMe?: boolean;
}

/**
 * Authentication request payload for registration
 * @interface RegisterRequest
 * @since 1.0.0
 */
export interface RegisterRequest {
  /** User's email address */
  email: string;
  
  /** User's password */
  password: string;
  
  /** User's first name */
  firstName: string;
  
  /** User's last name */
  lastName: string;
  
  /** Optional initial role (defaults to GUEST) */
  role?: UserRole;
}

/**
 * Successful authentication response
 * @interface AuthResponse
 * @since 1.0.0
 */
export interface AuthResponse {
  /** Success indicator */
  success: true;
  
  /** Authenticated user data (excluding sensitive fields) */
  user: Omit<User, 'jwtSecureCode'>;
  
  /** JWT access token (short-lived) */
  accessToken: string;
  
  /** JWT refresh token (long-lived) */
  refreshToken: string;
  
  /** Human-readable success message */
  message: string;
  
  /** Token expiration timestamp */
  expiresAt: Date;
}

/**
 * Authentication error response
 * @interface AuthErrorResponse
 * @since 1.0.0
 */
export interface AuthErrorResponse {
  /** Success indicator */
  success: false;
  
  /** Error code for programmatic handling */
  error: string;
  
  /** Human-readable error message */
  message: string;
  
  /** Optional additional error details */
  details?: Record<string, any>;
  
  /** Request correlation ID for support */
  correlationId?: string;
}

/**
 * JWT token payload structure
 * @interface JWTPayload
 * @since 1.0.0
 */
export interface JWTPayload {
  /** User identifier */
  userId: string;
  
  /** User's email address */
  email: string;
  
  /** User's role */
  role: UserRole;
  
  /** Token type ('access' or 'refresh') */
  type: 'access' | 'refresh';
  
  /** Token issued at timestamp */
