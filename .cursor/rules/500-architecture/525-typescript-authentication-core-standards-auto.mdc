export class AuthErrorHandler {
  private static readonly GENERIC_ERROR = 'An error occurred during authentication';
  
  // Predefined secure error responses
  private static readonly ERROR_RESPONSES: Record<string, AuthError> = {
    INVALID_CREDENTIALS: {
      code: 'INVALID_CREDENTIALS',
      message: 'Invalid email or password',
      statusCode: 401,
      isOperational: true
    },
    ACCOUNT_LOCKED: {
      code: 'ACCOUNT_LOCKED',
      message: 'Account temporarily locked due to multiple failed attempts',
      statusCode: 423,
      isOperational: true
    },
    TOKEN_EXPIRED: {
      code: 'TOKEN_EXPIRED',
      message: 'Authentication token has expired',
      statusCode: 401,
      isOperational: true
    },
    INSUFFICIENT_PERMISSIONS: {
      code: 'INSUFFICIENT_PERMISSIONS',
      message: 'Insufficient permissions for this operation',
      statusCode: 403,
      isOperational: true
    }
  };

  static handleAuthError(error: Error, req: Request, res: Response): void {
    const correlationId = this.generateCorrelationId();
    
    // Log detailed error for debugging (server-side only)
    this.logError(error, req, correlationId);
    
    // Return sanitized error to client
    const clientError = this.sanitizeError(error);
    
    res.status(clientError.statusCode).json({
      success: false,
      error: clientError.code,
      message: clientError.message,
      correlationId
    });
  }

  private static sanitizeError(error: Error): AuthError {
    // Map known errors to safe responses
    for (const [code, response] of Object.entries(this.ERROR_RESPONSES)) {
      if (error.message.includes(code)) {
        return response;
      }
    }

    // Default safe response for unknown errors
    return {
      code: 'AUTHENTICATION_ERROR',
      message: this.GENERIC_ERROR,
      statusCode: 500,
      isOperational: false
    };
  }

  private static logError(error: Error, req: Request, correlationId: string): void {
    const logEntry = {
      correlationId,
      error: {
        message: error.message,
        stack: error.stack,
        name: error.name
      },
      request: {
        method: req.method,
        url: req.url,
        ip: req.ip,
        userAgent: req.headers['user-agent']
      },
      timestamp: new Date()
    };

    console.error('Authentication Error:', JSON.stringify(logEntry, null, 2));
  }

  private static generateCorrelationId(): string {
    return `auth_${Date.now()}_${Math.random().toString(36).substr(2, 9)}`;
  }
}

export class AuditLogger {
  static async logAuthEvent(entry: Partial<AuditLogEntry>): Promise<void> {
    try {
      const fullEntry: AuditLogEntry = {
        action: entry.action || 'UNKNOWN',
        resource: entry.resource || 'authentication',
        success: entry.success ?? false,
        ipAddress: entry.ipAddress || 'unknown',
        userAgent: entry.userAgent || 'unknown',
        timestamp: entry.timestamp || new Date(),
        userId: entry.userId,
        details: entry.details
      };

      // Store in audit log database/service
      await this.persistAuditLog(fullEntry);
      
      // Also log to console for immediate visibility
      console.log('AUDIT:', JSON.stringify(fullEntry));
      
    } catch (error) {
      // Never let audit logging failure break the main flow
      console.error('Audit logging failed:', error);
    }
  }

  private static async persistAuditLog(entry: AuditLogEntry): Promise<void> {
    // Implementation depends on your audit storage system
    // Should be highly available and tamper-proof
  }

  // Specific audit log helpers
