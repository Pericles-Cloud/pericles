      <description>Use bcrypt with minimum 12 rounds for password hashing. Never store plain text passwords or use weak hashing algorithms like MD5 or SHA1.</description>
      <examples>
        <example title="Password Hashing Implementation">
          <correct-example title="Secure bcrypt password hashing with TypeScript" conditions="Implementing password hashing in authentication system" expected-result="Securely hashed passwords with proper salt generation" correctness-criteria="Uses bcrypt with 12+ rounds, proper error handling, and TypeScript types"><![CDATA[import bcrypt from 'bcrypt';

interface PasswordHashResult {
  hash: string;
  salt: string;
}

const SALT_ROUNDS = 12; // Minimum recommended for 2025

export const hashPassword = async (password: string): Promise<PasswordHashResult> => {
  try {
    const salt = await bcrypt.genSalt(SALT_ROUNDS);
    const hash = await bcrypt.hash(password, salt);
    
    return { hash, salt };
  } catch (error) {
    throw new Error(`Password hashing failed: ${error instanceof Error ? error.message : 'Unknown error'}`);
  }
};

export const verifyPassword = async (
  password: string, 
  hash: string
): Promise<boolean> => {
  try {
    return await bcrypt.compare(password, hash);
  } catch (error) {
    console.error('Password verification error:', error);
    return false; // Fail securely
  }
};]]></correct-example>
