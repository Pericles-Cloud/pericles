/**
 * Authentication service interface for dependency injection
 * @interface IAuthService
 * @since 1.0.0
 */
export interface IAuthService {
  /**
   * Authenticate user with email and password
   * @param credentials - Login credentials
   * @returns Promise resolving to authentication response
   * @throws {AuthError} When authentication fails
   */
  login(credentials: LoginRequest): Promise<AuthResponse>;
  
  /**
   * Register new user account
   * @param userData - Registration data
   * @returns Promise resolving to authentication response
   * @throws {AuthError} When registration fails
   */
  register(userData: RegisterRequest): Promise<AuthResponse>;
  
  /**
   * Refresh access token using refresh token
   * @param refreshToken - Valid refresh token
   * @returns Promise resolving to new authentication response
   * @throws {AuthError} When refresh fails
   */
  refreshToken(refreshToken: string): Promise<AuthResponse>;
  
  /**
   * Logout user and invalidate tokens
   * @param userId - User identifier
   * @param refreshToken - User's refresh token
   * @returns Promise resolving to success confirmation
   */
  logout(userId: string, refreshToken: string): Promise<{ success: boolean }>;
  
  /**
   * Initiate password reset process
   * @param request - Password reset request
   * @returns Promise resolving to success confirmation
   */
  requestPasswordReset(request: PasswordResetRequest): Promise<{ success: boolean }>;
  
  /**
   * Complete password reset with token
   * @param request - Password reset confirmation
   * @returns Promise resolving to success confirmation
   */
  confirmPasswordReset(request: PasswordResetConfirm): Promise<{ success: boolean }>;
}

/**
 * Type guard to check if response is successful authentication
 * @param response - Authentication response to check
 * @returns True if response is successful
 * @example
 * ```typescript
 * const response = await authService.login(credentials);
 * if (isAuthSuccess(response)) {
 *   // response is typed as AuthResponse
 *   console.log(response.user.email);
 * } else {
 *   // response is typed as AuthErrorResponse
 *   console.error(response.error);
 * }
 * ```
 */
export function isAuthSuccess(
  response: AuthResponse | AuthErrorResponse
): response is AuthResponse {
  return response.success === true;
}

/**
 * Type guard to check user role permissions
 * @param userRole - Role to check
 * @param requiredRole - Minimum required role
 * @returns True if user has sufficient permissions
 * @example
 * ```typescript
 * if (hasRole(user.role, 'ADMIN')) {
 *   // User has admin permissions or higher
 * }
 * ```
 */
export function hasRole(userRole: UserRole, requiredRole: UserRole): boolean {
  const roleHierarchy: Record<UserRole, number> = {
    GUEST: 0,
    MEMBER: 1,
    ADMIN: 2,
    OWNER: 3
  };
  
  return roleHierarchy[userRole] >= roleHierarchy[requiredRole];
}

/**
 * Utility type for API responses
 * @template T - Success response data type
 */
export type APIResponse<T = any> = 
  | (T & { success: true })
  | AuthErrorResponse;

/**
 * Express.js request interface with authenticated user
 * @interface AuthenticatedRequest
 * @extends Request
 */
export interface AuthenticatedRequest extends Request {
  /** Authenticated user information */
  user?: {
    id: string;
    email: string;
    role: UserRole;
  };
}]]></correct-example>
