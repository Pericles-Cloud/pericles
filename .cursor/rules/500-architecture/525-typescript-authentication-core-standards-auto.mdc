const environmentSchema = z.object({
  // JWT secrets validation
  JWT_SECRET: z
    .string()
    .min(32, 'JWT_SECRET must be at least 32 characters')
    .refine(secret => !/^(secret|password|123|test)/.test(secret.toLowerCase()), 
      'JWT_SECRET must not use common weak patterns'),
  
  JWT_REFRESH_SECRET: z
    .string()
    .min(32, 'JWT_REFRESH_SECRET must be at least 32 characters')
    .refine(secret => !/^(secret|password|123|test)/.test(secret.toLowerCase()), 
      'JWT_REFRESH_SECRET must not use common weak patterns'),
  
  JWT_ACCESS_EXPIRY: z.string().default('15m'),
  JWT_REFRESH_EXPIRY: z.string().default('7d'),
  
  // Google OAuth validation
  GOOGLE_CLIENT_ID: z
    .string()
    .min(1, 'GOOGLE_CLIENT_ID is required')
    .refine(id => id.endsWith('.apps.googleusercontent.com'), 
      'GOOGLE_CLIENT_ID must be a valid Google OAuth client ID'),
  
  GOOGLE_CLIENT_SECRET: z
    .string()
    .min(24, 'GOOGLE_CLIENT_SECRET must be at least 24 characters'),
  
  GOOGLE_OAUTH_REDIRECT_URI: z
    .string()
    .url('GOOGLE_OAUTH_REDIRECT_URI must be a valid URL'),
  
  // Database validation
  DATABASE_URL: z
    .string()
    .url('DATABASE_URL must be a valid URL')
    .refine(url => url.startsWith('postgresql://'), 
      'DATABASE_URL must be a PostgreSQL connection string'),
  
  // Security settings
  BCRYPT_ROUNDS: z
    .string()
    .transform(val => parseInt(val, 10))
    .refine(rounds => rounds >= 12, 'BCRYPT_ROUNDS must be at least 12')
    .default('12'),
  
  SESSION_TIMEOUT: z
    .string()
    .transform(val => parseInt(val, 10))
    .default('900000'), // 15 minutes in milliseconds
  
  MAX_LOGIN_ATTEMPTS: z
    .string()
    .transform(val => parseInt(val, 10))
    .default('5'),
  
  LOCKOUT_DURATION: z
    .string()
    .transform(val => parseInt(val, 10))
    .default('900000'), // 15 minutes in milliseconds
  
  // Email configuration
  SMTP_HOST: z.string().min(1, 'SMTP_HOST is required'),
  SMTP_PORT: z
    .string()
    .transform(val => parseInt(val, 10))
    .refine(port => port > 0 && port <= 65535, 'SMTP_PORT must be valid')
    .default('587'),
  
  SMTP_USER: z.string().min(1, 'SMTP_USER is required'),
  SMTP_PASSWORD: z.string().min(1, 'SMTP_PASSWORD is required'),
  FROM_EMAIL: z.string().email('FROM_EMAIL must be a valid email'),
  
  // Application URLs
  FRONTEND_URL: z.string().url('FRONTEND_URL must be a valid URL'),
  BACKEND_URL: z.string().url('BACKEND_URL must be a valid URL'),
  
  // Security
  CORS_ORIGINS: z
    .string()
    .transform(origins => origins.split(',').map(origin => origin.trim()))
    .default(''),
  
  TRUSTED_PROXIES: z
    .string()
    .transform(proxies => proxies.split(',').map(proxy => proxy.trim()))
    .default('')
});

export class EnvironmentConfig {
  private static _instance: AuthEnvironmentConfig | null = null;
  
  static getInstance(): AuthEnvironmentConfig {
    if (!this._instance) {
      this._instance = this.validateAndLoad();
    }
    return this._instance;
  }
  
  private static validateAndLoad(): AuthEnvironmentConfig {
    try {
      const env = environmentSchema.parse(process.env);
      
      return {
        jwtSecret: env.JWT_SECRET,
        jwtRefreshSecret: env.JWT_REFRESH_SECRET,
        jwtAccessExpiry: env.JWT_ACCESS_EXPIRY,
        jwtRefreshExpiry: env.JWT_REFRESH_EXPIRY,
        
        googleClientId: env.GOOGLE_CLIENT_ID,
        googleClientSecret: env.GOOGLE_CLIENT_SECRET,
        googleOAuthRedirectUri: env.GOOGLE_OAUTH_REDIRECT_URI,
        
        databaseUrl: env.DATABASE_URL,
        
        bcryptRounds: env.BCRYPT_ROUNDS,
        sessionTimeout: env.SESSION_TIMEOUT,
        maxLoginAttempts: env.MAX_LOGIN_ATTEMPTS,
        lockoutDuration: env.LOCKOUT_DURATION,
        
        smtpHost: env.SMTP_HOST,
        smtpPort: env.SMTP_PORT,
        smtpUser: env.SMTP_USER,
        smtpPassword: env.SMTP_PASSWORD,
        fromEmail: env.FROM_EMAIL,
        
        frontendUrl: env.FRONTEND_URL,
        backendUrl: env.BACKEND_URL,
        
        corsOrigins: env.CORS_ORIGINS,
        trustedProxies: env.TRUSTED_PROXIES
      };
    } catch (error) {
      if (error instanceof z.ZodError) {
        const missingFields = error.errors.map(err => `${err.path.join('.')}: ${err.message}`);
        throw new Error(`Environment configuration validation failed:\n${missingFields.join('\n')}`);
      }
      throw new Error('Failed to load environment configuration');
    }
  }
  
  static validateSecrets(): void {
    const config = this.getInstance();
    
    // Additional runtime security checks
    if (config.jwtSecret === config.jwtRefreshSecret) {
      throw new Error('JWT_SECRET and JWT_REFRESH_SECRET must be different');
    }
    
    if (process.env.NODE_ENV === 'production') {
      if (config.frontendUrl.includes('localhost') || config.backendUrl.includes('localhost')) {
        throw new Error('Localhost URLs not allowed in production');
      }
      
      if (!config.frontendUrl.startsWith('https://') || !config.backendUrl.startsWith('https://')) {
        throw new Error('HTTPS required in production');
      }
    }
  }
}

