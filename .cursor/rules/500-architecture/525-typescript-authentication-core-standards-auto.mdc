    <non-negotiable priority="critical">
      <description>Implement secure JWT token management with short-lived access tokens (15 minutes max), refresh tokens, proper secret management, and token verification. Use TypeScript interfaces for token payloads.</description>
      <examples>
        <example title="JWT Token Implementation">
          <correct-example title="Secure JWT implementation with TypeScript types" conditions="Implementing JWT authentication system" expected-result="Type-safe JWT system with proper token lifecycle management" correctness-criteria="Uses short-lived tokens, proper secret management, TypeScript interfaces, and secure verification"><![CDATA[import jwt from 'jsonwebtoken';
import type { JwtPayload } from 'jsonwebtoken';

interface AccessTokenPayload extends JwtPayload {
  userId: string;
  email: string;
  role: 'OWNER' | 'ADMIN' | 'MEMBER' | 'GUEST';
  type: 'access';
}

interface RefreshTokenPayload extends JwtPayload {
  userId: string;
  email: string;
  type: 'refresh';
  jwtSecureCode: string; // Rotating secret for additional security
}

interface TokenPair {
  accessToken: string;
  refreshToken: string;
}

export class JWTService {
  private readonly accessTokenSecret: string;
  private readonly refreshTokenSecret: string;
  private readonly accessTokenExpiry = '15m'; // Short-lived
  private readonly refreshTokenExpiry = '7d';

  constructor() {
    this.accessTokenSecret = process.env.JWT_SECRET!;
    this.refreshTokenSecret = process.env.JWT_REFRESH_SECRET!;
    
    if (!this.accessTokenSecret || !this.refreshTokenSecret) {
      throw new Error('JWT secrets must be configured');
    }
  }

  generateTokenPair(payload: {
    userId: string;
    email: string;
    role: AccessTokenPayload['role'];
    jwtSecureCode: string;
  }): TokenPair {
    const accessToken = jwt.sign(
      {
        userId: payload.userId,
        email: payload.email,
        role: payload.role,
        type: 'access'
      } as AccessTokenPayload,
      this.accessTokenSecret,
      { expiresIn: this.accessTokenExpiry }
    );

    const refreshToken = jwt.sign(
      {
        userId: payload.userId,
        email: payload.email,
        type: 'refresh',
        jwtSecureCode: payload.jwtSecureCode
      } as RefreshTokenPayload,
      this.refreshTokenSecret,
      { expiresIn: this.refreshTokenExpiry }
    );

    return { accessToken, refreshToken };
  }

  verifyAccessToken(token: string): AccessTokenPayload | null {
    try {
      const decoded = jwt.verify(token, this.accessTokenSecret) as AccessTokenPayload;
      return decoded.type === 'access' ? decoded : null;
    } catch (error) {
      return null; // Token invalid or expired
    }
  }

  verifyRefreshToken(token: string): RefreshTokenPayload | null {
    try {
      const decoded = jwt.verify(token, this.refreshTokenSecret) as RefreshTokenPayload;
      return decoded.type === 'refresh' ? decoded : null;
    } catch (error) {
      return null;
    }
  }
}]]></correct-example>
