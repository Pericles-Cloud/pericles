    <!-- Section 4: Input Validation and Sanitization -->
    <non-negotiable priority="critical">
      <description>Implement comprehensive input validation and sanitization for all authentication inputs using TypeScript schemas and validation libraries. Validate email formats, password complexity, and sanitize user inputs to prevent injection attacks.</description>
      <examples>
        <example title="Input Validation Implementation">
          <correct-example title="Comprehensive input validation with TypeScript schemas" conditions="Validating authentication inputs" expected-result="Type-safe input validation with proper sanitization and error handling" correctness-criteria="Uses validation schemas, TypeScript types, email validation, password complexity checks, and input sanitization"><![CDATA[import * as z from 'zod';
import validator from 'validator';

// TypeScript schemas for authentication inputs
const emailSchema = z
  .string()
  .email('Invalid email format')
  .max(254, 'Email too long') // RFC 5321 limit
  .refine(email => validator.isEmail(email), 'Invalid email format');

const passwordSchema = z
  .string()
  .min(8, 'Password must be at least 8 characters')
  .max(128, 'Password too long')
  .refine(password => /[A-Z]/.test(password), 'Password must contain uppercase letter')
  .refine(password => /[a-z]/.test(password), 'Password must contain lowercase letter')
  .refine(password => /\d/.test(password), 'Password must contain number')
  .refine(password => /[!@#$%^&*(),.?":{}|<>]/.test(password), 'Password must contain special character');

const registerSchema = z.object({
  email: emailSchema,
  password: passwordSchema,
  firstName: z
    .string()
    .min(1, 'First name required')
    .max(50, 'First name too long')
    .refine(name => validator.isAlpha(name.replace(/\s/g, ''), 'en-US'), 'Invalid first name'),
  lastName: z
    .string()
    .min(1, 'Last name required')
    .max(50, 'Last name too long')
    .refine(name => validator.isAlpha(name.replace(/\s/g, ''), 'en-US'), 'Invalid last name')
});

const loginSchema = z.object({
  email: emailSchema,
  password: z.string().min(1, 'Password required')
});

interface ValidationResult<T> {
  success: boolean;
  data?: T;
  errors?: string[];
}

interface RegisterInput {
  email: string;
  password: string;
  firstName: string;
  lastName: string;
}

interface LoginInput {
  email: string;
  password: string;
}

export class AuthValidationService {
  static validateRegistration(input: unknown): ValidationResult<RegisterInput> {
    try {
      const sanitizedInput = this.sanitizeInput(input);
      const validated = registerSchema.parse(sanitizedInput);
      
      return {
        success: true,
        data: {
          email: validator.normalizeEmail(validated.email) || validated.email,
          password: validated.password,
          firstName: validator.escape(validated.firstName.trim()),
          lastName: validator.escape(validated.lastName.trim())
        }
      };
    } catch (error) {
      const errors = error instanceof z.ZodError 
        ? error.errors.map(e => e.message)
        : ['Validation failed'];
        
      return { success: false, errors };
    }
  }

  static validateLogin(input: unknown): ValidationResult<LoginInput> {
    try {
      const sanitizedInput = this.sanitizeInput(input);
      const validated = loginSchema.parse(sanitizedInput);
      
      return {
        success: true,
        data: {
          email: validator.normalizeEmail(validated.email) || validated.email,
          password: validated.password
        }
      };
    } catch (error) {
      const errors = error instanceof z.ZodError 
        ? error.errors.map(e => e.message)
        : ['Validation failed'];
        
      return { success: false, errors };
    }
  }

  private static sanitizeInput(input: unknown): any {
    if (typeof input !== 'object' || input === null) {
      throw new Error('Invalid input format');
    }

    const sanitized: any = {};
    for (const [key, value] of Object.entries(input)) {
      if (typeof value === 'string') {
        // Remove null bytes and normalize whitespace
        sanitized[key] = value.replace(/\0/g, '').trim();
      } else {
        sanitized[key] = value;
      }
    }

    return sanitized;
  }

  static isPasswordCompromised(password: string): boolean {
    // Check against common password lists
    const commonPasswords = [
      'password', '123456', 'password123', 'admin', 'qwerty',
      'letmein', 'welcome', 'monkey', '1234567890'
    ];
    
    return commonPasswords.includes(password.toLowerCase());
  }
}]]></correct-example>
