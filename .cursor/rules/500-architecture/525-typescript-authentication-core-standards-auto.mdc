          <correct-example title="Type-safe environment configuration with secrets validation" conditions="Configuring authentication environment variables" expected-result="Secure configuration management with proper validation and TypeScript types" correctness-criteria="Uses TypeScript interfaces, validates all secrets, implements secure defaults, and provides clear error messages for missing configuration"><![CDATA[import * as z from 'zod';

interface AuthEnvironmentConfig {
  // JWT Configuration
  jwtSecret: string;
  jwtRefreshSecret: string;
  jwtAccessExpiry: string;
  jwtRefreshExpiry: string;
  
  // Google OAuth Configuration  
  googleClientId: string;
  googleClientSecret: string;
  googleOAuthRedirectUri: string;
  
  // Database Configuration
  databaseUrl: string;
  
  // Security Configuration
  bcryptRounds: number;
  sessionTimeout: number;
  maxLoginAttempts: number;
  lockoutDuration: number;
  
  // Email Configuration (for verification)
