    <!-- Performance Optimization and Monitoring -->
    <requirement priority="high">
      <description>Implement comprehensive performance monitoring and optimization for Neon databases. Use connection pooling metrics, query performance tracking, and Neon's built-in monitoring features for proactive optimization.</description>
      <examples>
        <example title="Performance Monitoring">
          <correct-example title="Comprehensive performance monitoring setup" conditions="Monitoring production Neon database" expected-result="Proactive performance optimization with detailed metrics" correctness-criteria="Connection pool monitoring, query performance tracking, Neon metrics integration, alerting setup"><![CDATA[import { Pool } from 'pg';
import { neon } from '@neondatabase/serverless';

class NeonPerformanceMonitor {
  private pool: Pool;
  private metrics: Map<string, any> = new Map();
  
  constructor() {
    this.pool = new Pool({
      connectionString: process.env.DATABASE_URL,
      max: 20,
      min: 5,
      idleTimeoutMillis: 30000,
      // Enable detailed logging
      log: (level: string, msg: string) => {
        console.log(`[DB-${level.toUpperCase()}]`, msg);
      }
    });
    
    // Monitor pool events
    this.pool.on('connect', () => {
      console.log('New database connection established');
      this.updateMetric('connections_created', 1);
    });
    
    this.pool.on('remove', () => {
      console.log('Database connection removed');
      this.updateMetric('connections_removed', 1);
    });
    
    this.pool.on('error', (err) => {
      console.error('Database pool error:', err);
      this.updateMetric('connection_errors', 1);
    });
  }
  
  async executeQuery(query: string, params?: any[]) {
    const startTime = Date.now();
    const client = await this.pool.connect();
    
    try {
      const result = await client.query(query, params);
      const duration = Date.now() - startTime;
      
      // Track query performance
      this.trackQueryPerformance(query, duration, true);
      
      return result;
    } catch (error) {
      const duration = Date.now() - startTime;
      this.trackQueryPerformance(query, duration, false);
      throw error;
    } finally {
      client.release();
    }
  }
  
  private trackQueryPerformance(query: string, duration: number, success: boolean) {
    const queryType = query.trim().split(' ')[0].toLowerCase();
    const metricKey = `query_${queryType}_duration`;
    
    if (!this.metrics.has(metricKey)) {
      this.metrics.set(metricKey, { total: 0, count: 0, avg: 0, max: 0 });
    }
    
    const metric = this.metrics.get(metricKey);
    metric.total += duration;
    metric.count += 1;
    metric.avg = metric.total / metric.count;
    metric.max = Math.max(metric.max, duration);
    
    // Alert on slow queries
    if (duration > 5000) { // 5 seconds
      console.warn(`Slow query detected: ${query.substring(0, 100)}... (${duration}ms)`);
    }
    
    // Track success rate
    this.updateMetric(`query_${queryType}_${success ? 'success' : 'error'}`, 1);
  }
  
  private updateMetric(key: string, value: number) {
    const current = this.metrics.get(key) || 0;
    this.metrics.set(key, current + value);
  }
  
  getMetrics() {
    return {
      pool_stats: {
        total_connections: this.pool.totalCount,
        idle_connections: this.pool.idleCount,
        waiting_count: this.pool.waitingCount,
      },
      performance_metrics: Object.fromEntries(this.metrics),
      timestamp: new Date().toISOString(),
    };
  }
  
  // Integration with monitoring services
  async sendMetricsToMonitoring() {
    const metrics = this.getMetrics();
    
    // Send to your monitoring service (DataDog, New Relic, etc.)
    // Example with custom endpoint
    try {
      await fetch(process.env.METRICS_ENDPOINT, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(metrics)
      });
    } catch (error) {
      console.error('Failed to send metrics:', error);
    }
  }
}

// Usage in application
const dbMonitor = new NeonPerformanceMonitor();

// Periodic metrics reporting
setInterval(() => {
  dbMonitor.sendMetricsToMonitoring();
}, 60000); // Every minute]]></correct-example>
