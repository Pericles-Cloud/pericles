    <!-- Neon Data API Integration -->
    <requirement priority="high">
      <description>Utilize Neon Data API for serverless and edge computing scenarios. Implement proper API key management, request batching, and error handling for HTTP-based database access.</description>
      <examples>
        <example title="Data API Implementation">
          <correct-example title="Secure Data API usage with batching" conditions="Building edge-deployed application" expected-result="Efficient HTTP-based database access" correctness-criteria="Proper API key security, request batching, comprehensive error handling"><![CDATA[import { neon } from '@neondatabase/serverless';

class NeonDataAPI {
  private sql: ReturnType<typeof neon>;
  
  constructor() {
    if (!process.env.DATABASE_URL) {
      throw new Error('DATABASE_URL environment variable is required');
    }
    
    this.sql = neon(process.env.DATABASE_URL, {
      arrayMode: false,
      fullResults: true
    });
  }
  
  async batchOperations(operations: Array<{query: string, params?: any[]}>) {
    try {
      // Batch multiple operations efficiently
      const results = await Promise.all(
        operations.map(op => this.sql(op.query, op.params))
      );
      
      return results;
    } catch (error) {
      console.error('Batch operation failed:', error);
      throw new Error('Database batch operation failed');
    }
  }
  
  async safeQuery<T>(query: string, params?: any[]): Promise<T[]> {
    try {
      const result = await this.sql(query, params);
      return result as T[];
    } catch (error) {
      if (error.code === 'CONNECTION_TIMEOUT') {
        // Retry once on timeout
        return await this.sql(query, params) as T[];
      }
      throw error;
    }
  }
}

// Usage in Edge Runtime
export default async function handler(request: Request) {
  const db = new NeonDataAPI();
  
  const users = await db.safeQuery<User>(
    'SELECT * FROM users WHERE status = $1',
    ['active']
  );
  
  return Response.json(users);
}]]></correct-example>
