    <!-- Neon Authentication Integration -->
    <requirement priority="high">
      <description>Integrate Neon Auth for user authentication and session management. Implement proper JWT handling, refresh token rotation, and secure authentication flows with Neon's built-in auth features.</description>
      <examples>
        <example title="Neon Auth Integration">
          <correct-example title="Complete Neon Auth implementation" conditions="Implementing user authentication" expected-result="Secure authentication with proper session management" correctness-criteria="Uses Neon Auth, proper JWT handling, refresh token rotation, secure session storage"><![CDATA[import { createNeonAuth } from '@neondatabase/auth';

const auth = createNeonAuth({
  databaseUrl: process.env.DATABASE_URL,
  jwtSecret: process.env.JWT_SECRET,
  cookieOptions: {
    secure: process.env.NODE_ENV === 'production',
    sameSite: 'strict',
    httpOnly: true,
    maxAge: 7 * 24 * 60 * 60 * 1000, // 7 days
  },
  refreshTokenRotation: true,
  sessionTimeout: 30 * 60 * 1000, // 30 minutes
});

// Secure login implementation
export async function loginUser(email: string, password: string) {
  try {
    const { user, session } = await auth.signInWithPassword({
      email,
      password,
    });
    
    // Set secure session cookie
    await auth.setSession(session);
    
    return { user, success: true };
  } catch (error) {
    console.error('Login failed:', error);
    throw new Error('Authentication failed');
  }
}

// Middleware for protected routes
export async function requireAuth(request: Request) {
  const session = await auth.getSession(request);
  
  if (!session || !session.user) {
    throw new Error('Authentication required');
  }
  
  // Refresh token if needed
  if (session.expires_at < Date.now() + 5 * 60 * 1000) {
    const refreshed = await auth.refreshSession(session.refresh_token);
    await auth.setSession(refreshed);
  }
  
  return session.user;
}

// RLS context setting
export async function setRLSContext(user: any) {
  const sql = neon(process.env.DATABASE_URL);
  await sql`SET request.jwt.claims = ${JSON.stringify({
    sub: user.id,
    email: user.email,
    role: user.role,
    tenant_id: user.tenant_id
  })}`;
}]]></correct-example>
