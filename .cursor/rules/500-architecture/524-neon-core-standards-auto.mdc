          <correct-example title="Comprehensive security setup" conditions="Implementing production security" expected-result="Secure database access with comprehensive protection" correctness-criteria="Encryption at rest and in transit, proper access controls, audit logging, compliance measures"><![CDATA[// Security configuration for Neon
import { neon } from '@neondatabase/serverless';
import crypto from 'crypto';

class SecureNeonClient {
  private sql: ReturnType<typeof neon>;
  private encryptionKey: Buffer;
  
  constructor() {
    // Validate security requirements
    if (!process.env.DATABASE_URL?.includes('sslmode=require')) {
      throw new Error('SSL must be required for database connections');
    }
    
    if (!process.env.ENCRYPTION_KEY || process.env.ENCRYPTION_KEY.length < 32) {
      throw new Error('Strong encryption key required');
    }
    
    this.sql = neon(process.env.DATABASE_URL, {
      // Force SSL
      ssl: 'require',
    });
    
    this.encryptionKey = Buffer.from(process.env.ENCRYPTION_KEY, 'hex');
  }
  
  // Encrypt sensitive data before storage
  encryptData(data: string): string {
    const iv = crypto.randomBytes(16);
    const cipher = crypto.createCipher('aes-256-gcm', this.encryptionKey);
    cipher.setAAD(Buffer.from('neon-app'));
    
    let encrypted = cipher.update(data, 'utf8', 'hex');
    encrypted += cipher.final('hex');
    
    const authTag = cipher.getAuthTag();
    return iv.toString('hex') + ':' + authTag.toString('hex') + ':' + encrypted;
  }
  
  // Decrypt sensitive data after retrieval
  decryptData(encryptedData: string): string {
    const parts = encryptedData.split(':');
    const iv = Buffer.from(parts[0], 'hex');
    const authTag = Buffer.from(parts[1], 'hex');
    const encrypted = parts[2];
    
    const decipher = crypto.createDecipher('aes-256-gcm', this.encryptionKey);
    decipher.setAAD(Buffer.from('neon-app'));
    decipher.setAuthTag(authTag);
    
    let decrypted = decipher.update(encrypted, 'hex', 'utf8');
    decrypted += decipher.final('utf8');
    
    return decrypted;
  }
  
  // Audit logging for sensitive operations
  async auditLog(operation: string, userId: string, details: any) {
    await this.sql`
      INSERT INTO audit_logs (
        operation, user_id, details, ip_address, user_agent, timestamp
      ) VALUES (
        ${operation},
        ${userId},
        ${JSON.stringify(details)},
        ${details.ipAddress},
        ${details.userAgent},
        NOW()
      )
    `;
  }
  
  // Secure query execution with validation
  async secureQuery(query: string, params: any[], userId?: string) {
    // Input validation
    if (this.containsSqlInjection(query)) {
      throw new Error('Potential SQL injection detected');
    }
    
    try {
      const result = await this.sql(query, params);
      
      // Log successful access
      if (userId) {
        await this.auditLog('query_executed', userId, {
          query: query.substring(0, 100), // Truncated for privacy
          paramCount: params.length,
          resultCount: result.length
        });
      }
      
      return result;
    } catch (error) {
      // Log failed access attempts
      if (userId) {
        await this.auditLog('query_failed', userId, {
          query: query.substring(0, 100),
          error: error.message
        });
      }
      throw error;
    }
  }
  
  private containsSqlInjection(query: string): boolean {
    const dangerousPatterns = [
      /;\s*(drop|delete|truncate|alter)\s/i,
      /union\s+select/i,
      /or\s+1\s*=\s*1/i,
      /'\s*or\s*'/i
    ];
    
    return dangerousPatterns.some(pattern => pattern.test(query));
  }
}

// Database schema for security
-- Enable necessary extensions
CREATE EXTENSION IF NOT EXISTS "uuid-ossp";
CREATE EXTENSION IF NOT EXISTS "pgcrypto";

-- Audit log table
CREATE TABLE audit_logs (
  id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
  operation VARCHAR(100) NOT NULL,
  user_id UUID,
  details JSONB,
  ip_address INET,
  user_agent TEXT,
  timestamp TIMESTAMP WITH TIME ZONE DEFAULT NOW()
);

-- Enable RLS on audit logs
ALTER TABLE audit_logs ENABLE ROW LEVEL SECURITY;

-- Policy: Users can only see their own audit logs
CREATE POLICY audit_logs_user_access ON audit_logs
  FOR SELECT
  USING (user_id = auth.uid());

-- Policy: Only system can insert audit logs
CREATE POLICY audit_logs_system_insert ON audit_logs
  FOR INSERT
  WITH CHECK (auth.role() = 'service_role');

-- Indexes for performance
CREATE INDEX idx_audit_logs_user_id ON audit_logs(user_id);
CREATE INDEX idx_audit_logs_timestamp ON audit_logs(timestamp);

// Usage with proper security
const secureClient = new SecureNeonClient();

export async function handleSensitiveOperation(userId: string, data: any) {
  // Encrypt sensitive data
  const encryptedData = secureClient.encryptData(JSON.stringify(data.sensitive));
  
  // Execute with audit logging
  const result = await secureClient.secureQuery(
    'INSERT INTO sensitive_table (user_id, encrypted_data) VALUES ($1, $2) RETURNING id',
    [userId, encryptedData],
    userId
  );
  
  return result;
}]]></correct-example>
