          <correct-example title="Neon-optimized migration workflow" conditions="Managing database schema changes" expected-result="Safe and tested migrations with proper branching" correctness-criteria="Uses Neon branches for testing, proper rollback procedures, schema versioning"><![CDATA[// Migration management with Neon branches
import { execSync } from 'child_process';

class NeonMigrationManager {
  constructor(private neonApiKey: string, private projectId: string) {}
  
  async createMigrationBranch(migrationName: string): Promise<string> {
    const branchName = `migration-${migrationName}-${Date.now()}`;
    
    // Create branch using Neon CLI
    const command = `neon branches create --name "${branchName}" --project-id ${this.projectId}`;
    execSync(command, { env: { ...process.env, NEON_API_KEY: this.neonApiKey } });
    
    return branchName;
  }
  
  async testMigration(branchName: string, migrationSQL: string): Promise<boolean> {
    try {
      // Get branch connection string
      const branchUrl = this.getBranchConnectionString(branchName);
      const sql = neon(branchUrl);
      
      // Apply migration to branch
      await sql(migrationSQL);
      
      // Run validation tests
      await this.validateMigration(sql);
      
      return true;
    } catch (error) {
      console.error('Migration test failed:', error);
      return false;
    }
  }
  
  async validateMigration(sql: any) {
    // Test that all required tables exist
    const tables = await sql`
      SELECT table_name 
      FROM information_schema.tables 
      WHERE table_schema = 'public'
    `;
    
    // Validate indexes
    const indexes = await sql`
      SELECT indexname, tablename 
      FROM pg_indexes 
      WHERE schemaname = 'public'
    `;
    
    // Test sample queries
    await sql`SELECT 1`; // Basic connectivity
    
    console.log(`Migration validation passed: ${tables.length} tables, ${indexes.length} indexes`);
  }
  
  async applyMigration(migrationName: string, migrationSQL: string) {
    // Create and test on branch first
    const branchName = await this.createMigrationBranch(migrationName);
    
    try {
      const testPassed = await this.testMigration(branchName, migrationSQL);
      
      if (!testPassed) {
        throw new Error('Migration failed validation on test branch');
      }
      
      // Apply to main branch
      const mainUrl = process.env.DATABASE_URL;
      const sql = neon(mainUrl);
      
      // Begin transaction for atomic migration
      await sql`BEGIN`;
      
      try {
        // Record migration start
        await sql`
          INSERT INTO migration_history (name, applied_at, status)
          VALUES (${migrationName}, NOW(), 'applying')
        `;
        
        // Apply migration
        await sql(migrationSQL);
        
        // Update migration status
        await sql`
          UPDATE migration_history 
          SET status = 'completed', completed_at = NOW()
          WHERE name = ${migrationName}
        `;
        
        await sql`COMMIT`;
        
        console.log(`Migration ${migrationName} applied successfully`);
        
      } catch (error) {
        await sql`ROLLBACK`;
        
        // Record failure
        await sql`
          UPDATE migration_history 
          SET status = 'failed', error_message = ${error.message}
          WHERE name = ${migrationName}
        `;
        
        throw error;
      }
      
    } finally {
      // Clean up test branch
      await this.deleteBranch(branchName);
    }
  }
  
  private getBranchConnectionString(branchName: string): string {
    // Implementation to get branch connection string via Neon API
    // This would use the Neon API to get the connection string for the branch
    return `postgresql://user:pass@${branchName}.neon.tech/db`;
  }
  
  private async deleteBranch(branchName: string) {
    const command = `neon branches delete "${branchName}" --project-id ${this.projectId}`;
    execSync(command, { env: { ...process.env, NEON_API_KEY: this.neonApiKey } });
  }
}

// Migration history table
-- Create migration tracking table
CREATE TABLE IF NOT EXISTS migration_history (
  id SERIAL PRIMARY KEY,
  name VARCHAR(255) NOT NULL UNIQUE,
  applied_at TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
  completed_at TIMESTAMP WITH TIME ZONE,
  status VARCHAR(50) DEFAULT 'pending',
  error_message TEXT,
  rollback_sql TEXT
);

// GitHub Actions integration
name: Database Migration
on:
  push:
    paths:
      - 'migrations/**'
    branches:
      - main

jobs:
  migrate:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      
      - name: Test Migration on Neon Branch
        env:
          NEON_API_KEY: ${{ secrets.NEON_API_KEY }}
          PROJECT_ID: ${{ vars.NEON_PROJECT_ID }}
        run: |
          # Create test branch and validate migration
          node scripts/test-migration.js
          
      - name: Apply Migration to Production
        if: success()
        env:
          DATABASE_URL: ${{ secrets.DATABASE_URL }}
          NEON_API_KEY: ${{ secrets.NEON_API_KEY }}
        run: |
          node scripts/apply-migration.js]]></correct-example>
