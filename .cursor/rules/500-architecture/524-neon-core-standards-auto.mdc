    <!-- Database Branching and Development Workflow -->
    <requirement priority="critical">
      <description>Implement Neon database branching for development workflows. Create branches for feature development, testing, and staging environments. Use branch-specific connection strings and automate branch management in CI/CD pipelines.</description>
      <examples>
        <example title="Database Branching Strategy">
          <correct-example title="Proper branching workflow with automation" conditions="Setting up feature branch development" expected-result="Isolated database environments for each branch" correctness-criteria="Uses Neon CLI for branch management with proper naming and cleanup"><![CDATA[// GitHub Actions workflow for branch management
name: Database Branch Management
on:
  pull_request:
    types: [opened, synchronize]
  
jobs:
  setup-db-branch:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Create Neon Branch
        run: |
          # Create branch with descriptive name
          BRANCH_NAME="feature-$(echo ${{ github.head_ref }} | sed 's/[^a-zA-Z0-9-]/-/g')"
          
          neon branches create \
            --name "$BRANCH_NAME" \
            --parent main \
            --database ${{ vars.NEON_DATABASE_NAME }}
          
          # Get branch connection string
          BRANCH_URL=$(neon connection-string --branch "$BRANCH_NAME")
          echo "DATABASE_URL=$BRANCH_URL" >> $GITHUB_ENV
          
      - name: Run Migrations on Branch
        run: |
          npx prisma migrate deploy
          npx prisma db seed]]></correct-example>
