class NeonConnectionManager {
  private pool: Pool;
  
  constructor() {
    this.pool = new Pool({
      connectionString: process.env.DATABASE_URL,
      max: 20, // Match expected concurrent load
      min: 5,  // Keep minimum connections warm
      acquireTimeoutMillis: 60000,
