// api/admin/saml/configure.ts - SAML Configuration
import type { VercelRequest, VercelResponse } from '@vercel/node';
import { requireAdminPermission } from '../middleware/permissions';
import { validateSAMLMetadata, validateX509Certificate } from '../../../lib/saml-validation';

export default async function handler(req: VercelRequest, res: VercelResponse) {
  await requireAdminPermission('SAML_CONFIG', 'CREATE', 'ORGANIZATION')(req, res, () => {});
  
  if (req.method !== 'POST') {
    return res.status(405).json({ error: 'Method not allowed' });
  }

  const {
    identityProviderName,
    entityId,
    ssoUrl,
    sloUrl,
    x509Certificate,
    attributeMapping,
    autoCreateAccounts,
    defaultRole,
    defaultUserGroups
  } = req.body;

  try {
    // Validate SAML configuration
    const validationErrors = [];
    
    if (!validateSAMLMetadata(entityId, ssoUrl)) {
      validationErrors.push('Invalid SAML metadata configuration');
    }
    
    if (!validateX509Certificate(x509Certificate)) {
      validationErrors.push('Invalid X.509 certificate format');
    }
    
    if (!attributeMapping.email || !attributeMapping.firstName || !attributeMapping.lastName) {
      validationErrors.push('Required attribute mappings missing (email, firstName, lastName)');
    }

    if (validationErrors.length > 0) {
      return res.status(400).json({
        success: false,
        error: 'VALIDATION_FAILED',
        details: validationErrors
      });
    }

    // Check for existing SAML configuration
    const existingConfig = await prisma.saml_configurations.findUnique({
      where: { organization_id: req.user.organizationId }
    });

    let samlConfig;
    if (existingConfig) {
      // Update existing configuration
      samlConfig = await prisma.saml_configurations.update({
        where: { id: existingConfig.id },
        data: {
          identity_provider_name: identityProviderName,
          entity_id: entityId,
          sso_url: ssoUrl,
          slo_url: sloUrl,
          x509_certificate: x509Certificate,
          attribute_mapping: attributeMapping,
          auto_create_accounts: autoCreateAccounts,
          default_role: defaultRole,
          default_user_groups: defaultUserGroups,
          updated_by: req.user.id,
          updated_at: new Date()
        }
      });
    } else {
      // Create new configuration
      samlConfig = await prisma.saml_configurations.create({
        data: {
          organization_id: req.user.organizationId,
          enabled: false, // Start disabled for testing
          identity_provider_name: identityProviderName,
          entity_id: entityId,
          sso_url: ssoUrl,
          slo_url: sloUrl,
          x509_certificate: x509Certificate,
          attribute_mapping: attributeMapping,
          auto_create_accounts: autoCreateAccounts,
          default_role: defaultRole,
          default_user_groups: defaultUserGroups,
          created_by: req.user.id
        }
      });
    }

    // Create audit log
    await prisma.audit_logs.create({
      data: {
        user_id: req.user.id,
        action: existingConfig ? 'ADMIN_SAML_CONFIG_UPDATED' : 'ADMIN_SAML_CONFIG_CREATED',
        resource_type: 'saml_configuration',
        resource_id: samlConfig.id,
        success: true,
        details: {
          identityProviderName,
          autoCreateAccounts,
          defaultRole,
          attributeMappingFields: Object.keys(attributeMapping)
        },
        ip_address: req.headers['x-forwarded-for'] as string || 'unknown',
        user_agent: req.headers['user-agent'] || 'unknown'
      }
    });

    return res.json({
      success: true,
      configuration: {
        id: samlConfig.id,
        enabled: samlConfig.enabled,
        identityProviderName: samlConfig.identity_provider_name,
        autoCreateAccounts: samlConfig.auto_create_accounts,
        defaultRole: samlConfig.default_role
      },
      message: `SAML configuration ${existingConfig ? 'updated' : 'created'} successfully`
    });
  } catch (error) {
    console.error('SAML configuration error:', error);
    return res.status(500).json({ error: 'Internal server error' });
  } finally {
    await prisma.$disconnect();
  }
}

// api/auth/saml/callback.ts - SAML Authentication Handler
import { verifySSAMLResponse, extractSAMLAttributes } from '../../../lib/saml-auth';

export default async function handler(req: VercelRequest, res: VercelResponse) {
  if (req.method !== 'POST') {
    return res.status(405).json({ error: 'Method not allowed' });
  }

  try {
    const { SAMLResponse, RelayState } = req.body;
    
    // Extract organization from RelayState
    const organizationId = extractOrganizationFromRelayState(RelayState);
    
    // Get SAML configuration for organization
    const samlConfig = await prisma.saml_configurations.findUnique({
      where: { 
        organization_id: organizationId,
        enabled: true
      }
    });

    if (!samlConfig) {
      return res.status(400).json({ error: 'SAML not configured for organization' });
    }

    // Verify SAML response
    const verificationResult = await verifySSAMLResponse(SAMLResponse, samlConfig);
    if (!verificationResult.valid) {
      // Audit failed authentication
      await prisma.audit_logs.create({
        data: {
          action: 'SAML_AUTH_FAILED',
          resource_type: 'authentication',
          success: false,
          details: { errors: verificationResult.errors },
          ip_address: req.headers['x-forwarded-for'] as string || 'unknown',
          user_agent: req.headers['user-agent'] || 'unknown'
        }
      });
      
      return res.status(401).json({ error: 'Invalid SAML response' });
    }

    // Extract user attributes from SAML response
    const attributes = extractSAMLAttributes(verificationResult.assertions, samlConfig.attribute_mapping);
    
    // Find or create user based on auto-create setting
    let user = await prisma.users.findUnique({
      where: { email: attributes.email.toLowerCase() }
    });

    if (!user && samlConfig.auto_create_accounts) {
      // Auto-create user account
      user = await prisma.users.create({
        data: {
          email: attributes.email.toLowerCase(),
          first_name: attributes.firstName,
          last_name: attributes.lastName,
          role: samlConfig.default_role,
          organization_id: organizationId,
          account_status: 'ACTIVE',
          email_status: 'VERIFIED', // Trust SAML provider
          auth_provider: 'SAML',
          auth_provider_id: attributes.nameId
        }
      });

      // Assign to default user groups
      if (samlConfig.default_user_groups?.length > 0) {
        await Promise.all(samlConfig.default_user_groups.map(groupId =>
          prisma.user_group_members.create({
            data: {
              user_id: user.id,
              group_id: groupId,
              added_by: 'SYSTEM'
            }
          })
        ));
      }
    } else if (!user) {
      return res.status(401).json({ error: 'Account not found and auto-creation disabled' });
    }

    // Generate JWT tokens for authenticated user
    const accessToken = jwt.sign(
      { userId: user.id, email: user.email, role: user.role },
      process.env.JWT_SECRET!,
