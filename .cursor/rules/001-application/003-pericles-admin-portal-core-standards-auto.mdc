export interface AdminPermission {
  resource: AdminResource;
  actions: AdminAction[];
  scope: 'ORGANIZATION' | 'USER_GROUP' | 'SELF';
}

export type AdminResource = 
  | 'USER_MANAGEMENT' 
  | 'ROLE_ASSIGNMENT' 
  | 'SAML_CONFIG' 
  | 'AI_TRAINING' 
  | 'BULK_IMPORT' 
  | 'INTEGRATIONS' 
  | 'NOTIFICATIONS' 
  | 'PERSONAL_SETTINGS';

export type AdminAction = 'CREATE' | 'READ' | 'UPDATE' | 'DELETE' | 'EXECUTE';

// Role definitions with specific permissions
export const ADMIN_ROLE_PERMISSIONS: Record<AdminRole, AdminPermission[]> = {
  ADMIN: [
    { resource: 'USER_MANAGEMENT', actions: ['CREATE', 'READ', 'UPDATE', 'DELETE'], scope: 'ORGANIZATION' },
    { resource: 'ROLE_ASSIGNMENT', actions: ['CREATE', 'READ', 'UPDATE', 'DELETE'], scope: 'ORGANIZATION' },
    { resource: 'SAML_CONFIG', actions: ['CREATE', 'READ', 'UPDATE', 'DELETE'], scope: 'ORGANIZATION' },
    { resource: 'AI_TRAINING', actions: ['CREATE', 'READ', 'UPDATE', 'DELETE', 'EXECUTE'], scope: 'ORGANIZATION' },
    { resource: 'BULK_IMPORT', actions: ['CREATE', 'READ', 'EXECUTE'], scope: 'ORGANIZATION' },
    { resource: 'INTEGRATIONS', actions: ['CREATE', 'READ', 'UPDATE', 'DELETE'], scope: 'ORGANIZATION' },
    { resource: 'NOTIFICATIONS', actions: ['CREATE', 'READ', 'UPDATE', 'DELETE'], scope: 'ORGANIZATION' },
    { resource: 'PERSONAL_SETTINGS', actions: ['READ', 'UPDATE'], scope: 'SELF' }
  ],
  MANAGER: [
    { resource: 'USER_MANAGEMENT', actions: ['READ'], scope: 'USER_GROUP' },
    { resource: 'PERSONAL_SETTINGS', actions: ['READ', 'UPDATE'], scope: 'SELF' },
    { resource: 'NOTIFICATIONS', actions: ['READ', 'UPDATE'], scope: 'SELF' }
  ],
  VIEWER: [
    { resource: 'PERSONAL_SETTINGS', actions: ['READ', 'UPDATE'], scope: 'SELF' },
    { resource: 'NOTIFICATIONS', actions: ['READ', 'UPDATE'], scope: 'SELF' }
  ]
};

// Permission check utility following SaaS authentication patterns
export const hasAdminPermission = (
  user: AdminUser, 
  resource: AdminResource, 
  action: AdminAction,
  targetScope: 'ORGANIZATION' | 'USER_GROUP' | 'SELF' = 'SELF'
): boolean => {
  const userPermissions = ADMIN_ROLE_PERMISSIONS[user.adminRole];
  
  return userPermissions.some(permission => 
    permission.resource === resource &&
    permission.actions.includes(action) &&
    (permission.scope === targetScope || permission.scope === 'ORGANIZATION')
  );
};

// API middleware for admin permission enforcement
// api/admin/middleware/permissions.ts
import type { VercelRequest, VercelResponse } from '@vercel/node';
import { hasAdminPermission } from '../../../types/admin';

interface AdminRequest extends VercelRequest {
  user?: AdminUser;
  requiredPermission?: {
    resource: AdminResource;
    action: AdminAction;
    scope?: 'ORGANIZATION' | 'USER_GROUP' | 'SELF';
  };
}

export const requireAdminPermission = (
  resource: AdminResource,
  action: AdminAction,
  scope: 'ORGANIZATION' | 'USER_GROUP' | 'SELF' = 'SELF'
) => {
  return (req: AdminRequest, res: VercelResponse, next: () => void) => {
    if (!req.user) {
      return res.status(401).json({ error: 'Authentication required' });
    }

    if (!hasAdminPermission(req.user, resource, action, scope)) {
      // Create audit log for permission denial
      await prisma.audit_logs.create({
        data: {
          user_id: req.user.id,
          action: 'ADMIN_PERMISSION_DENIED',
          resource_type: 'admin_portal',
          resource_id: `${resource}:${action}:${scope}`,
          success: false,
          details: { deniedPermission: { resource, action, scope } },
          ip_address: req.headers['x-forwarded-for'] as string || 'unknown',
          user_agent: req.headers['user-agent'] || 'unknown'
        }
      });

      return res.status(403).json({ 
        error: 'Insufficient permissions',
        required: { resource, action, scope },
        userRole: req.user.adminRole
      });
    }

    req.requiredPermission = { resource, action, scope };
    next();
  };
};]]></correct-example>
