    <!-- Database Schema and Data Management -->
    <requirement priority="critical">
      <description>Extend existing Prisma schema with admin portal specific tables including user groups, SAML configurations, training documents, AI agent configs, integrations, and user settings while maintaining consistency with established SaaS authentication schema.</description>
      <examples>
        <example title="Admin Portal Database Schema">
          <correct-example title="Comprehensive Prisma schema extension for admin portal" conditions="Extending database schema for admin functionality" expected-result="Complete admin portal data model with proper relationships" correctness-criteria="Extends existing SaaS schema with admin tables, proper foreign keys, indexes, and data consistency"><![CDATA[// prisma/schema.prisma - Admin Portal Extensions
// Extend existing User model with admin fields
model User {
  id                          String   @id @default(cuid())
  email                       String   @unique
  password_hash               String
  password_salt               String
  first_name                  String
  last_name                   String
  role                        Role     @default(GUEST)
  admin_role                  AdminRole @default(VIEWER) // New admin role field
  organization_id             String   // Link to organization
  account_status              AccountStatus @default(PENDING)
  email_status               EmailStatus @default(UNVERIFIED)
  auth_provider              String?   // For SAML/OAuth
  auth_provider_id           String?   // External provider ID
  last_admin_access          DateTime? // Track admin portal usage
  created_at                  DateTime @default(now())
  updated_at                  DateTime @updatedAt

  // Existing relations
  sessions                    UserSession[]
  audit_logs                  AuditLog[]
  
  // New admin-specific relations
  created_users              User[] @relation("UserCreatedBy")
  created_by_user            User?  @relation("UserCreatedBy", fields: [created_by], references: [id])
  created_by                 String?
  
  user_group_memberships     UserGroupMember[]
  uploaded_training_docs     TrainingDocument[]
  created_integrations       Integration[]
  user_settings              UserSettings?

  @@map("users")
}

enum AdminRole {
  ADMIN
  MANAGER  
  VIEWER
}

// User Groups for organizational management
model UserGroup {
  id                String   @id @default(cuid())
  organization_id   String
  name              String
  description       String
  permissions       String[] // JSON array of permissions
  created_by        String
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  // Relations
  members           UserGroupMember[]
  created_by_user   User @relation(fields: [created_by], references: [id])

  @@map("user_groups")
  @@unique([organization_id, name])
}

model UserGroupMember {
  id         String   @id @default(cuid())
  user_id    String
  group_id   String
  added_by   String
  added_at   DateTime @default(now())

  // Relations
  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  group      UserGroup @relation(fields: [group_id], references: [id], onDelete: Cascade)
  added_by_user User   @relation("UserGroupAdder", fields: [added_by], references: [id])

  @@map("user_group_members")
  @@unique([user_id, group_id])
}

// SAML SSO Configuration
model SAMLConfiguration {
  id                        String   @id @default(cuid())
  organization_id           String   @unique
  enabled                   Boolean  @default(false)
  identity_provider_name    String
  entity_id                 String
  sso_url                   String
  slo_url                   String?
  x509_certificate          String
  attribute_mapping         Json     // SAML attribute mappings
  auto_create_accounts      Boolean  @default(false)
  default_role              Role     @default(GUEST)
  default_admin_role        AdminRole @default(VIEWER)
  default_user_groups       String[] // Array of group IDs
  created_by                String
  created_at                DateTime @default(now())
  updated_at                DateTime @updatedAt
  last_tested_at            DateTime?
  test_results              Json?    // Test results and errors

  // Relations
  created_by_user           User @relation("SAMLCreatedBy", fields: [created_by], references: [id])

  @@map("saml_configurations")
}

// AI Training Documents
model TrainingDocument {
  id                String   @id @default(cuid())
  organization_id   String
  file_name         String
  file_type         String   // PDF, DOCX, TXT, MD
  file_size         Int
  uploaded_by       String
  uploaded_at       DateTime @default(now())
  processed_at      DateTime?
  extracted_text    String?  @db.Text
  document_type     String   // STRATEGY, RISK_PLAN, POLICY, etc.
  tags              String[]
  vector_embeddings Float[]  // For semantic search
  is_active         Boolean  @default(true)

  // Relations
  uploaded_by_user  User @relation(fields: [uploaded_by], references: [id])
  agent_trainings   AIAgentTraining[]

  @@map("training_documents")
  @@index([organization_id, document_type])
  @@index([organization_id, is_active])
}

// AI Agent Configurations
model AIAgentConfig {
  id                   String   @id @default(cuid())
  organization_id      String
  agent_type           String   // ATLAS, EVENT_INSIGHT, PLAN_EXECUTION
  name                 String
  description          String
  configuration        Json     // Agent-specific config
  performance_metrics  Json     // Performance tracking
  is_active            Boolean  @default(true)
  created_by           String
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt
  last_trained_at      DateTime?

  // Relations
  created_by_user      User @relation("AIAgentCreatedBy", fields: [created_by], references: [id])
  training_sessions    AIAgentTraining[]

  @@map("ai_agent_configs")
  @@unique([organization_id, agent_type, name])
}

model AIAgentTraining {
  id                   String   @id @default(cuid())
  agent_id             String
  document_id          String
  training_status      String   // PENDING, PROCESSING, COMPLETED, FAILED
  started_at           DateTime @default(now())
  completed_at         DateTime?
  performance_impact   Json?    // Before/after metrics
  error_message        String?

  // Relations
  agent                AIAgentConfig @relation(fields: [agent_id], references: [id], onDelete: Cascade)
  document             TrainingDocument @relation(fields: [document_id], references: [id], onDelete: Cascade)

  @@map("ai_agent_training")
  @@unique([agent_id, document_id])
}

// Third-party Integrations
model Integration {
  id                String   @id @default(cuid())
  organization_id   String
  type              String   // SLACK, MICROSOFT_TEAMS, GOOGLE_WORKSPACE, etc.
  name              String
  enabled           Boolean  @default(false)
  configuration     Json     // Integration-specific config
  encrypted_credentials String // Encrypted API keys/tokens
  webhook_url       String?
  last_sync_at      DateTime?
  sync_status       String   @default("DISABLED") // ACTIVE, ERROR, DISABLED
  error_message     String?
  created_by        String
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  // Relations
  created_by_user   User @relation(fields: [created_by], references: [id])

  @@map("integrations")
  @@unique([organization_id, type, name])
}

// User Personal Settings
model UserSettings {
  id                     String   @id @default(cuid())
  user_id                String   @unique
  appearance             String   @default("SYSTEM") // SYSTEM, LIGHT, DARK
  language               String   @default("en")
  timezone               String   @default("AUTO")   // AUTO or specific timezone
  default_landing_page   String   @default("ATLAS")  // ATLAS, EVENTS, INSIGHTS, PLANS
  notification_settings  Json     // Notification preferences
  created_at             DateTime @default(now())
  updated_at             DateTime @updatedAt

  // Relations
  user                   User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

// Bulk User Import Tracking
model BulkUserImport {
  id                String   @id @default(cuid())
  organization_id   String
  file_name         String
  uploaded_by       String
  total_rows        Int
  success_count     Int      @default(0)
  error_count       Int      @default(0)
  errors            Json?    // Array of import errors
  status            String   @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  created_at        DateTime @default(now())
  completed_at      DateTime?

  // Relations
  uploaded_by_user  User @relation("BulkImportUploadedBy", fields: [uploaded_by], references: [id])

  @@map("bulk_user_imports")
  @@index([organization_id, status])
}

// Enhanced audit logs for admin actions
model AuditLog {
  id                String   @id @default(cuid())
  user_id           String?
  action            String   // Action type (e.g., USER_CREATED, SAML_CONFIGURED)
  resource_type     String   // Type of resource affected
  resource_id       String?  // ID of affected resource
  organization_id   String?  // For organizational-level actions
  success           Boolean
  details           Json?    // Additional context/data
  ip_address        String
  user_agent        String
  created_at        DateTime @default(now())

  // Relations
  user              User? @relation(fields: [user_id], references: [id])

  @@map("audit_logs")
  @@index([organization_id, action])
  @@index([user_id, created_at])
  @@index([created_at])
}]]></correct-example>
          <incorrect-example title="Basic schema without proper admin portal support" conditions="Extending database schema" expected-result="Complete admin portal data model" incorrectness-criteria="Missing admin-specific tables, poor relationships, no audit logging, or inadequate indexing"><![CDATA[// WRONG - incomplete schema extension
model User {
  id    String @id
  email String @unique
  // Missing admin fields, relationships, proper indexing
}

// Missing: UserGroup, SAMLConfiguration, TrainingDocument, AIAgentConfig, Integration tables]]></incorrect-example>
        </example>
      </examples>
    </requirement>
  </requirements>
  <context description="Pericles Admin Portal development context">
    The Pericles Admin Portal serves as the central administrative interface for organizational configuration and user management within the Pericles platform. It implements a sophisticated three-tier permission system (Admin/Manager/Viewer) with granular access controls and comprehensive feature sets tailored to each role.

    Key architectural considerations:
    - Built on established SaaS application foundation with React 19.1.0, TypeScript 5.8.3, and Tailwind CSS
    - Follows existing authentication patterns with JWT tokens and role-based access control
    - Extends Prisma schema with admin-specific tables while maintaining data consistency
    - Implements comprehensive audit logging for all administrative actions
    - Uses established API patterns with proper permission middleware
    - Follows mobile-first responsive design with modern UI components
    - Integrates with existing Docker local development and Neon production database
    - Maintains security best practices with encrypted credential storage and SAML SSO

    Permission Hierarchy:
    - **Admin**: Full organizational control including user management, SAML configuration, AI training, and all integrations
    - **Manager**: Limited to user area configuration and personal settings management  
    - **Viewer**: Restricted to personal settings and notification preferences only

    Core Features by Role:
    - User Management: Add/remove users, bulk import, role assignment, user groups (Admin only)
    - SAML SSO: Complete SSO configuration and management (Admin only)
    - AI Training: Document upload, agent configuration, performance monitoring (Admin only)
    - Integrations: Third-party tool connections and webhook management (Admin only)
    - Personal Settings: Appearance, language, timezone, notifications (All roles)
    - Organizational Config: Geographic regions, notification templates (Admin only)

    Security Considerations:
    - All endpoints require proper authentication and role-based authorization
    - Comprehensive audit logging for security and compliance
    - Encrypted storage of sensitive credentials and API keys
    - SAML certificate validation and secure SSO implementation
    - File upload security with malware scanning and type validation
    - Proper session management and token rotation

    The admin portal maintains consistency with the established SaaS application patterns while providing the specialized functionality required for organizational administration and AI agent training within the Pericles ecosystem.
  </context>
