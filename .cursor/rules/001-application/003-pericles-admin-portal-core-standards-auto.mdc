// api/admin/ai-training/documents/upload.ts - Secure Document Upload
import type { VercelRequest, VercelResponse } from '@vercel/node';
import { requireAdminPermission } from '../../middleware/permissions';
import { processDocument, extractText, generateEmbeddings } from '../../../../lib/ai-processing';
import { validateFileType, sanitizeFileName, scanForMalware } from '../../../../lib/file-security';

export default async function handler(req: VercelRequest, res: VercelResponse) {
  await requireAdminPermission('AI_TRAINING', 'CREATE', 'ORGANIZATION')(req, res, () => {});
  
  if (req.method !== 'POST') {
    return res.status(405).json({ error: 'Method not allowed' });
  }

  try {
    const { fileData, fileName, fileType, documentType, tags } = req.body;

    // Validate file type and security
    if (!validateFileType(fileType, ['PDF', 'DOCX', 'TXT', 'MD'])) {
      return res.status(400).json({
        success: false,
        error: 'INVALID_FILE_TYPE',
        message: 'Only PDF, DOCX, TXT, and MD files are allowed'
      });
    }

    // Security scan for malicious content
    const securityScan = await scanForMalware(fileData);
    if (!securityScan.safe) {
      // Log security incident
      await prisma.audit_logs.create({
        data: {
          user_id: req.user.id,
          action: 'AI_TRAINING_SECURITY_VIOLATION',
          resource_type: 'document_upload',
          success: false,
          details: {
            fileName: sanitizeFileName(fileName),
            securityIssues: securityScan.issues
          },
          ip_address: req.headers['x-forwarded-for'] as string || 'unknown',
          user_agent: req.headers['user-agent'] || 'unknown'
        }
      });

      return res.status(400).json({
        success: false,
        error: 'SECURITY_VIOLATION',
        message: 'File failed security scan'
      });
    }

    // Extract text content from document
    const extractedText = await extractText(fileData, fileType);
    if (!extractedText || extractedText.length < 100) {
      return res.status(400).json({
        success: false,
        error: 'INSUFFICIENT_CONTENT',
        message: 'Document must contain at least 100 characters of text'
      });
    }

    // Generate vector embeddings for semantic search
    const vectorEmbeddings = await generateEmbeddings(extractedText);

    // Create training document record
    const trainingDocument = await prisma.training_documents.create({
      data: {
        organization_id: req.user.organizationId,
        file_name: sanitizeFileName(fileName),
        file_type: fileType,
        file_size: Buffer.byteLength(fileData),
        uploaded_by: req.user.id,
        extracted_text: extractedText,
        document_type: documentType,
        tags: tags || [],
        vector_embeddings: vectorEmbeddings,
        is_active: true
      }
    });

    // Update related AI agents with new training data
    await updateAgentTraining(req.user.organizationId, trainingDocument.id);

    // Create audit log
    await prisma.audit_logs.create({
      data: {
        user_id: req.user.id,
        action: 'AI_TRAINING_DOCUMENT_UPLOADED',
        resource_type: 'training_document',
        resource_id: trainingDocument.id,
        success: true,
        details: {
          fileName: trainingDocument.file_name,
          documentType,
          fileSize: trainingDocument.file_size,
          textLength: extractedText.length,
          tags: tags || []
        },
        ip_address: req.headers['x-forwarded-for'] as string || 'unknown',
        user_agent: req.headers['user-agent'] || 'unknown'
      }
    });

    return res.json({
      success: true,
      document: {
        id: trainingDocument.id,
        fileName: trainingDocument.file_name,
        documentType: trainingDocument.document_type,
        fileSize: trainingDocument.file_size,
        uploadedAt: trainingDocument.uploaded_at
      },
      message: 'Training document uploaded and processed successfully'
    });
  } catch (error) {
    console.error('Document upload error:', error);
    return res.status(500).json({ error: 'Internal server error' });
  } finally {
    await prisma.$disconnect();
  }
}

// api/admin/ai-training/agents/configure.ts - AI Agent Configuration
export default async function handler(req: VercelRequest, res: VercelResponse) {
  await requireAdminPermission('AI_TRAINING', 'UPDATE', 'ORGANIZATION')(req, res, () => {});
  
  if (req.method !== 'PUT') {
    return res.status(405).json({ error: 'Method not allowed' });
  }

  try {
    const { agentId, configuration, specializations, geographicFocus, riskCategories } = req.body;

    // Validate agent ownership
    const agent = await prisma.ai_agent_configs.findFirst({
      where: {
        id: agentId,
        organization_id: req.user.organizationId
      }
    });

    if (!agent) {
      return res.status(404).json({
        success: false,
        error: 'AGENT_NOT_FOUND',
        message: 'AI agent not found for your organization'
      });
    }

    // Validate configuration parameters
    const validationErrors = validateAgentConfiguration(configuration);
    if (validationErrors.length > 0) {
      return res.status(400).json({
        success: false,
        error: 'INVALID_CONFIGURATION',
        details: validationErrors
      });
    }

    // Update agent configuration
    const updatedAgent = await prisma.ai_agent_configs.update({
      where: { id: agentId },
      data: {
        configuration: {
          ...configuration,
          specializations,
          geographicFocus,
          riskCategories,
          updatedAt: new Date()
        },
        updated_by: req.user.id,
        updated_at: new Date()
      }
    });

    // Trigger agent retraining with new configuration
    await triggerAgentRetraining(agentId, updatedAgent.configuration);

    // Create audit log
    await prisma.audit_logs.create({
      data: {
        user_id: req.user.id,
        action: 'AI_AGENT_CONFIGURED',
        resource_type: 'ai_agent',
        resource_id: agentId,
        success: true,
        details: {
          agentType: agent.agent_type,
          configurationChanges: {
            specializations,
            geographicFocus,
            riskCategories
          }
        },
        ip_address: req.headers['x-forwarded-for'] as string || 'unknown',
        user_agent: req.headers['user-agent'] || 'unknown'
      }
    });

    return res.json({
      success: true,
      agent: {
        id: updatedAgent.id,
        name: updatedAgent.name,
        agentType: updatedAgent.agent_type,
        lastTrainedAt: updatedAgent.last_trained_at
      },
      message: 'AI agent configuration updated successfully'
    });
  } catch (error) {
    console.error('Agent configuration error:', error);
    return res.status(500).json({ error: 'Internal server error' });
  } finally {
    await prisma.$disconnect();
  }
}

// lib/ai-processing.ts - AI Processing Utilities
export const updateAgentTraining = async (organizationId: string, documentId: string) => {
  const agents = await prisma.ai_agent_configs.findMany({
    where: { 
      organization_id: organizationId,
      is_active: true
    }
  });

  // Trigger retraining for all active agents
  for (const agent of agents) {
    await triggerAgentRetraining(agent.id, agent.configuration);
  }
};

export const triggerAgentRetraining = async (agentId: string, configuration: any) => {
  // Queue agent retraining job with new configuration
  await queueJob('agent-retraining', {
    agentId,
    configuration,
    timestamp: new Date()
  });
};

export const validateAgentConfiguration = (config: any): string[] => {
  const errors: string[] = [];
  
  if (!config.model || typeof config.model !== 'string') {
    errors.push('Model specification is required');
  }
  
  if (config.temperature < 0 || config.temperature > 1) {
    errors.push('Temperature must be between 0 and 1');
  }
  
  if (config.maxTokens < 100 || config.maxTokens > 8000) {
    errors.push('Max tokens must be between 100 and 8000');
  }
  
  return errors;
};]]></correct-example>
