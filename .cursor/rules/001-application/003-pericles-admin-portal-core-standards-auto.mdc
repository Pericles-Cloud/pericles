  // scope to tenant when not root-admin
  const orgId = req.user?.organizationId || '';
  const isUuid = /^[0-9a-f-]{36}$/i.test(orgId);
  if (isUuid) where.id = orgId;
}

// api/admin/organizations/import.ts / updates (write guard)
if (isRootReadOnly(req.user)) {
  return res.status(403).json({ success: false, error: 'READ_ONLY', message: 'Root non-admins have read-only access' });
}

