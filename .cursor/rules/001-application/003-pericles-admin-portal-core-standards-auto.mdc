export const ROOT_ORG_SLUG = 'pericles-root';
export const ROOT_ALLOWED_DOMAIN = 'pericles.cloud';

// lib/authz.ts
export const isRootUser = (user: AdminUser | null | undefined): boolean => {
  if (!user) return false;
  return user.organizationId === ROOT_ORG_SLUG || (user.email.toLowerCase().endsWith('@' + ROOT_ALLOWED_DOMAIN));
};

export const canManageAnyOrganization = (user: AdminUser | null | undefined): boolean => {
  return !!user && isRootUser(user) && user.adminRole === 'ADMIN';
};

export const isRootReadOnly = (user: AdminUser | null | undefined): boolean => {
  return !!user && isRootUser(user) && user.adminRole !== 'ADMIN';
};

// api/admin/organizations.ts (listing snippet)
