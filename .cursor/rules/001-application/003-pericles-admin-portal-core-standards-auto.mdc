// api/admin/users/create.ts - Individual User Creation
import type { VercelRequest, VercelResponse } from '@vercel/node';
import { requireAdminPermission } from '../middleware/permissions';
import { PrismaClient } from '@prisma/client';
import bcrypt from 'bcrypt';

const prisma = new PrismaClient();

export default async function handler(req: VercelRequest, res: VercelResponse) {
  // Apply permission middleware
  await requireAdminPermission('USER_MANAGEMENT', 'CREATE', 'ORGANIZATION')(req, res, () => {});
  
  if (req.method !== 'POST') {
    return res.status(405).json({ error: 'Method not allowed' });
  }

  const { email, firstName, lastName, role, userGroups, sendInvitation } = req.body;

  try {
    // Validate email format and uniqueness
    const existingUser = await prisma.users.findUnique({
      where: { email: email.toLowerCase() }
    });

    if (existingUser) {
      return res.status(400).json({
        success: false,
        error: 'USER_EXISTS',
        message: 'A user with this email already exists'
      });
    }

    // Generate temporary password for invitation
    const tempPassword = generateSecurePassword();
    const { hash, salt } = await hashPassword(tempPassword);

    // Create user with admin-specified role
    const newUser = await prisma.users.create({
      data: {
        email: email.toLowerCase(),
        password_hash: hash,
        password_salt: salt,
        first_name: firstName,
        last_name: lastName,
        role: role || 'GUEST',
        admin_role: 'VIEWER', // Default admin role
        organization_id: req.user.organizationId,
        account_status: 'PENDING',
        email_status: 'UNVERIFIED',
        email_verification_token: generateVerificationToken(),
        created_by: req.user.id
      }
    });

    // Assign to user groups if specified
    if (userGroups && userGroups.length > 0) {
      await Promise.all(userGroups.map(groupId => 
        prisma.user_group_members.create({
          data: {
            user_id: newUser.id,
            group_id: groupId,
            added_by: req.user.id
          }
        })
      ));
    }

    // Send invitation email if requested
    if (sendInvitation) {
      await sendUserInvitationEmail(newUser, tempPassword);
    }

    // Create audit log
    await prisma.audit_logs.create({
      data: {
        user_id: req.user.id,
        action: 'ADMIN_USER_CREATED',
        resource_type: 'user',
        resource_id: newUser.id,
        success: true,
        details: { 
          newUserEmail: newUser.email,
          assignedRole: newUser.role,
          userGroups: userGroups || [],
          invitationSent: sendInvitation
        },
        ip_address: req.headers['x-forwarded-for'] as string || 'unknown',
        user_agent: req.headers['user-agent'] || 'unknown'
      }
    });

    return res.json({
      success: true,
      user: {
        id: newUser.id,
        email: newUser.email,
        firstName: newUser.first_name,
        lastName: newUser.last_name,
        role: newUser.role,
        accountStatus: newUser.account_status
      },
      message: 'User created successfully'
    });
  } catch (error) {
    console.error('User creation error:', error);
    return res.status(500).json({ error: 'Internal server error' });
  } finally {
    await prisma.$disconnect();
  }
}

// api/admin/users/bulk-import.ts - Bulk User Import
export default async function bulkImportHandler(req: VercelRequest, res: VercelResponse) {
  await requireAdminPermission('BULK_IMPORT', 'EXECUTE', 'ORGANIZATION')(req, res, () => {});
  
  if (req.method !== 'POST') {
    return res.status(405).json({ error: 'Method not allowed' });
  }

  try {
    const { csvData, fileName } = req.body;
    
    // Create bulk import record
    const bulkImport = await prisma.bulk_user_imports.create({
      data: {
        organization_id: req.user.organizationId,
        file_name: fileName,
        uploaded_by: req.user.id,
        total_rows: csvData.length,
        status: 'PROCESSING'
      }
    });

    // Process CSV data with validation
    const results = await processBulkUserImport(csvData, req.user.organizationId, req.user.id);
    
    // Update bulk import with results
    await prisma.bulk_user_imports.update({
      where: { id: bulkImport.id },
      data: {
        success_count: results.successCount,
        error_count: results.errorCount,
        errors: results.errors,
        status: results.errorCount > 0 ? 'COMPLETED' : 'COMPLETED',
        completed_at: new Date()
      }
    });

    // Create audit log
    await prisma.audit_logs.create({
      data: {
        user_id: req.user.id,
        action: 'ADMIN_BULK_USER_IMPORT',
        resource_type: 'user_import',
        resource_id: bulkImport.id,
        success: true,
        details: {
          fileName,
          totalRows: csvData.length,
          successCount: results.successCount,
          errorCount: results.errorCount
        },
        ip_address: req.headers['x-forwarded-for'] as string || 'unknown',
        user_agent: req.headers['user-agent'] || 'unknown'
      }
    });

    return res.json({
      success: true,
      bulkImportId: bulkImport.id,
      results: {
        total: csvData.length,
        successful: results.successCount,
        errors: results.errorCount,
        errorDetails: results.errors
      }
    });
  } catch (error) {
    console.error('Bulk import error:', error);
    return res.status(500).json({ error: 'Internal server error' });
  } finally {
    await prisma.$disconnect();
  }
}]]></correct-example>
