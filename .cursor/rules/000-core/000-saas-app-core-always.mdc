    <!-- Vercel Deployment Configuration -->
    <non-negotiable priority="critical">
      <description>Configure vercel.json for optimal TypeScript/React/Vite deployment following 500-architecture/526-vercel-deployment-core-standards-auto.mdc standards. Implement comprehensive Git integration, serverless function optimization, security headers, performance optimization, and production deployment workflows with proper monitoring and CI/CD integration.</description>
      <examples>
        <example title="Vercel Configuration">
          <correct-example title="Optimal vercel.json following Vercel deployment standards" conditions="Configuring Vercel deployment" expected-result="Production-ready Vercel deployment with comprehensive optimization" correctness-criteria="Follows 526-vercel-deployment-core-standards-auto.mdc, includes security headers, function optimization, Git integration, monitoring"><![CDATA[{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm ci",
  "nodeVersion": "20.x",
  "functions": {
    "api/**/*.ts": {
      "runtime": "@vercel/node@3.1.7",
      "maxDuration": 10,
      "memory": 1024,
      "regions": ["iad1", "sfo1"]
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET,OPTIONS,PATCH,DELETE,POST,PUT"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "X-CSRF-Token, X-Requested-With, Accept, Accept-Version, Content-Length, Content-MD5, Content-Type, Date, X-Api-Version, Authorization"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://vercel.live; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self' https:; font-src 'self'; object-src 'none'; frame-ancestors 'none';"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    },
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "github": {
    "enabled": true,
    "autoAlias": false,
    "silent": false
  }
}

