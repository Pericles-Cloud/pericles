      <description>Use Neon serverless PostgreSQL for production database following 500-architecture/524-neon-core-standards-auto.mdc standards. Implement proper connection pooling, autoscaling configuration, database branching for development workflows, Row-Level Security (RLS) policies, Neon Data API integration for edge functions, and comprehensive security practices including encryption and audit logging.</description>
      <examples>
        <example title="Neon Production Configuration">
          <correct-example title="Proper Neon connection and autoscaling setup" conditions="Configuring production Neon database" expected-result="Efficient serverless database with proper pooling and security" correctness-criteria="Uses pooled connections, proper autoscaling settings, RLS policies, branch management, security measures"><![CDATA[// lib/neon.ts - Production Neon configuration
import { neon } from '@neondatabase/serverless';
import { Pool } from '@neondatabase/serverless';

// Edge Runtime compatible for Vercel Edge Functions
export const sql = neon(process.env.DATABASE_URL!, {
  arrayMode: false,
  fullResults: true
});

// Node.js Runtime with connection pooling for Vercel Functions
let pool: Pool | null = null;

export function getNeonPool(): Pool {
  if (!pool) {
    pool = new Pool({
      connectionString: process.env.DATABASE_URL,
      // Optimized for Vercel serverless functions
      max: 1, // Single connection per serverless function
      idleTimeoutMillis: 0, // No idle timeout for short-lived functions
      connectionTimeoutMillis: 10000,
      ssl: { rejectUnauthorized: false }
    });
  }
  return pool;
}

// Environment variables for different environments
// .env.local (Local Development - Docker PostgreSQL)
DATABASE_URL=postgresql://postgres:dev_password_2025@localhost:5433/saas_app_dev

// .env.production (Vercel Production - Neon)
DATABASE_URL=postgresql://username:password@ep-xxx.pooler.us-east-1.neon.tech/saas_app_prod?sslmode=require
DIRECT_DATABASE_URL=postgresql://username:password@ep-xxx.us-east-1.neon.tech/saas_app_prod?sslmode=require

// Prisma schema for Neon production
// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")      // Pooled connection for normal operations
  directUrl = env("DIRECT_DATABASE_URL") // Direct connection for migrations
}

// RLS implementation for multi-tenant security
-- Enable RLS on sensitive tables
ALTER TABLE users ENABLE ROW LEVEL SECURITY;
ALTER TABLE projects ENABLE ROW LEVEL SECURITY;

-- Create policies using JWT claims
CREATE POLICY users_own_data ON users
  FOR ALL
  USING (auth.uid() = id);

CREATE POLICY tenant_isolation ON projects
  FOR ALL
  USING (tenant_id = auth.jwt() ->> 'tenant_id');

// Neon branch management for feature development
// .github/workflows/neon-branch.yml
name: Neon Branch Management
on:
  pull_request:
    types: [opened, synchronize, closed]

jobs:
  manage-db-branch:
    runs-on: ubuntu-latest
    steps:
      - name: Create Neon Branch
        if: github.event.action != 'closed'
        run: |
          BRANCH_NAME="pr-${{ github.event.number }}"
          neon branches create \
            --name "$BRANCH_NAME" \
            --parent main \
            --project-id ${{ vars.NEON_PROJECT_ID }}
          
          # Update environment for this PR
          BRANCH_URL=$(neon connection-string --branch "$BRANCH_NAME")
          echo "DATABASE_URL=$BRANCH_URL" >> $GITHUB_ENV

      - name: Cleanup Branch
        if: github.event.action == 'closed'
        run: |
          neon branches delete "pr-${{ github.event.number }}" \
            --project-id ${{ vars.NEON_PROJECT_ID }}]]></correct-example>
