          <incorrect-example title="Mismatched versions" conditions="Preparing for release" expected-result="Consistent version tracking" incorrectness-criteria="Package.json and Git tags don't match, or AboutComponent shows hardcoded version"><![CDATA[// package.json
{
  "name": "saas-app",
  "version": "3.1.0"
}

// Git tag is v3.1.1 (MISMATCH!)

// AboutComponent.tsx
const packageVersion = '2.5.0'; // Hardcoded version (WRONG!)]]></incorrect-example>
        </example>
        <example title="Release Type Classification and Process">
          <correct-example title="Proper release process with user confirmation" conditions="Before any release or deployment" expected-result="Correctly incremented version with proper release type" correctness-criteria="Always asks user for release type, increments version correctly, follows complete release process"><![CDATA[// AI MUST ALWAYS ASK FIRST:
AI: "What type of release is this? (major/minor/patch)"
User: "minor"

// Then AI increments version: 3.1.1 → 3.2.0
// package.json update
{
  "version": "3.2.0"
}

// Complete release process:
git add package.json
git commit -m "chore: bump version to 3.2.0 for minor release"
git tag v3.2.0
git push && git push --tags
gh release create v3.2.0 --title "v3.2.0 - New Features" 
npx vercel --prod]]></correct-example>
          <incorrect-example title="Automatic version increment without user confirmation" conditions="Before any release or deployment" expected-result="User-confirmed release type" incorrectness-criteria="AI automatically increments version without asking user, or skips release process steps"><![CDATA[// WRONG - AI automatically increments without asking:
// package.json (AI changed without asking)
{
  "version": "3.2.0"  // Changed automatically - FORBIDDEN!
}

// Or skipping release process:
