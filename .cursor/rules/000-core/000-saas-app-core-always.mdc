    <non-negotiable priority="critical">
      <description>Use Prisma 6.12.0 for all database operations with type-safe queries, automated migrations, and proper schema management. Implement established Prisma patterns for authentication tables and application data operations with proper connection handling for serverless environments.</description>
      <examples>
        <example title="Prisma Database Operations">
          <correct-example title="Type-safe Prisma operations with proper connection management" conditions="Implementing database operations" expected-result="Type-safe database operations with proper error handling" correctness-criteria="Uses generated Prisma client, proper error handling, connection cleanup, and type safety"><![CDATA[// prisma/schema.prisma - Authentication schema
model User {
  id                          String   @id @default(cuid())
  email                       String   @unique
  password_hash               String
  password_salt               String
  first_name                  String
  last_name                   String
  role                        Role     @default(GUEST)
  account_status              AccountStatus @default(PENDING)
  email_status               EmailStatus @default(UNVERIFIED)
  email_verification_token    String?
  created_at                  DateTime @default(now())
  updated_at                  DateTime @updatedAt

  // Relations
  sessions                    UserSession[]
  audit_logs                  AuditLog[]

  @@map("users")
}

enum Role {
  OWNER
  ADMIN  
  MEMBER
  GUEST
}

// Database operations with Prisma
import { PrismaClient } from '@prisma/client';
import type { User, Role } from '@prisma/client';

const prisma = new PrismaClient({
  log: process.env.NODE_ENV === 'development' ? ['query', 'error'] : ['error']
});

export const createUser = async (userData: {
  email: string;
  password_hash: string;
  password_salt: string;
  first_name: string;
  last_name: string;
  role?: Role;
}): Promise<User> => {
  try {
    const user = await prisma.user.create({
      data: {
        ...userData,
        role: userData.role || 'GUEST'
      }
    });
    return user;
  } catch (error) {
    console.error('Error creating user:', error);
    throw error;
  } finally {
    await prisma.$disconnect();
  }
};

