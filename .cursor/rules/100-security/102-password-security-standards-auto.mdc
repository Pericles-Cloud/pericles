---
description: Password security standards aligned with NIST SP 800-63B and expert guidance
globs: "*"
alwaysApply: false
---

<rule>
  <meta>
    <title>Password Security Standards (NIST SP 800-63B Aligned)</title>
    <description>Comprehensive password (memorized secret) best practices for applications, aligned with NIST SP 800-63B and expert recommendations; standardized guidance for creation, validation, storage, reset, and UX.</description>
    <created-at utc-timestamp="1761000000">September 20, 2025, 00:00 UTC</created-at>
    <last-updated-at utc-timestamp="1761000000">September 20, 2025, 00:00 UTC</last-updated-at>
    <applies-to>
      <file-matcher glob="*">All application code and documentation involving passwords/memorized secrets</file-matcher>
      <action-matcher action="security">All security-related development work</action-matcher>
    </applies-to>
  </meta>

  <requirements>
    <non-negotiable priority="critical">
      <description>Follow NIST SP 800-63B for memorized secrets: minimum length 8, allow ≥64, no composition rules that reduce usability, block known-compromised passwords, allow pasting, and permit all printable characters including spaces.</description>
      <examples>
        <example title="Length and character policy">
          <correct-example title="Allow long passphrases and all characters" conditions="Creating password policy" expected-result="User can set long passphrases with any printable chars" correctness-criteria="Min 8, recommended 12+, allow spaces and all printable ASCII/Unicode">
<![CDATA[
// Frontend validation
const MIN_LENGTH = 8; // NIST minimum
const RECOMMENDED_LENGTH = 12; // recommended in guidance

function validateLength(pwd: string): boolean {
  return (pwd?.length ?? 0) >= MIN_LENGTH;
}
]]>
          </correct-example>
          <incorrect-example title="Disallow spaces or special characters" conditions="Creating password policy" expected-result="Inclusive character set" incorrectness-criteria="Rejects whitespace or limits symbols arbitrarily">// WRONG: rejects spaces/symbols, reduces usability</incorrect-example>
        </example>
      </examples>
    </non-negotiable>

    <non-negotiable priority="critical">
      <description>Check passwords against known-compromised lists (e.g., Have I Been Pwned or internal breach corpus) and reject matches. Do not leak whether a specific user’s password is compromised.</description>
      <examples>
        <example title="Compromised password screening">
          <correct-example title="Server-side breach corpus check" conditions="On password set/reset" expected-result="Reject known-compromised passwords" correctness-criteria="Network-safe check with rate limiting">
<![CDATA[
// Pseudocode
if (isInCompromisedCorpus(newPassword)) {
  return res.status(400).json({ error: 'WEAK_PASSWORD', message: 'Password appears in known breach lists' });
}
]]>
          </correct-example>
          <incorrect-example title="No screening" conditions="On password set/reset" expected-result="Screen against breaches" incorrectness-criteria="Allows compromised passwords">// WRONG: no compromised password screening</incorrect-example>
        </example>
      </examples>
    </non-negotiable>

    <requirement priority="high">
      <description>Provide a strength meter and actionable guidance; don’t require arbitrary composition rules. Encourage passphrases (≥12 chars) and advise avoiding common sequences, repeats, and personal info.</description>
      <examples>
        <example title="Strength and hints">
          <correct-example title="Meter + suggestions" conditions="Password UI" expected-result="User sees strength and specific tips" correctness-criteria="Shows progress and hints based on issues">
<![CDATA[
// UI hints based on analysis
const hints = [];
if (!/[A-Z]/.test(pwd)) hints.push('Add an uppercase letter');
if (pwd.length < 12) hints.push('Use 12+ characters for stronger security');
]]>
          </correct-example>
          <incorrect-example title="Complex composition rules" conditions="Password UI" expected-result="Usable guidance" incorrectness-criteria="Forces category counts, frequent rotation">// WRONG: require 1 upper, 1 digit, 1 symbol, rotate every 60 days</incorrect-example>
        </example>
      </examples>
    </requirement>

    <non-negotiable priority="critical">
      <description>Hash with a modern KDF (Argon2id preferred; alternatively bcrypt with cost ≥ 12). Store per-user salts and never store or log plaintext passwords or recoverable secrets.</description>
      <examples>
        <example title="Server storage">
          <correct-example title="Argon2id/bcrypt" conditions="Storing passwords" expected-result="One-way KDF + unique salt" correctness-criteria="Strong parameters, per-user salt, no plaintext">
<![CDATA[
// Example: bcryptjs with 12 rounds
const salt = bcrypt.genSaltSync(12);
const hash = bcrypt.hashSync(password, salt);
]]>
          </correct-example>
          <incorrect-example title="Plaintext or reversible" conditions="Storing passwords" expected-result="One-way hash only" incorrectness-criteria="Plaintext or reversible encryption">// WRONG: storing plaintext or AES-encrypted passwords</incorrect-example>
        </example>
      </examples>
    </non-negotiable>

    <requirement priority="high">
      <description>Reset and recovery: verify identity appropriately, issue time-limited, single-use tokens, and invalidate all sessions after password change. Do not disclose whether an email exists during reset initiation.</description>
      <examples>
        <example title="Reset flow">
          <correct-example title="Opaque response for reset start" conditions="Starting reset" expected-result="No user enumeration" correctness-criteria="Always return generic message">// "If an account exists, instructions have been sent"</correct-example>
          <incorrect-example title="Enumerates users" conditions="Starting reset" expected-result="Opaque response" incorrectness-criteria="Says user exists/doesn't exist">// WRONG: leaks user existence</incorrect-example>
        </example>
      </examples>
    </requirement>

    <requirement priority="high">
      <description>UX: allow paste and password managers; avoid artificial rate limits that break managers. Provide show/hide toggles and indicate Caps Lock. Support i18n keyboards.</description>
      <examples>
        <example title="Manager-friendly inputs">
          <correct-example title="Paste allowed" conditions="Password input" expected-result="Managers work" correctness-criteria="No paste prevention">// Allow paste and autocomplete where appropriate</correct-example>
          <incorrect-example title="Blocks paste" conditions="Password input" expected-result="Works with managers" incorrectness-criteria="Prevents paste">// WRONG: onpaste = preventDefault()</incorrect-example>
        </example>
      </examples>
    </requirement>

    <requirement priority="medium">
      <description>Rate limit and monitor password-related endpoints. Lockouts should be temporary and tuned to avoid account lockout DoS. Prefer step-up verification over permanent locks.</description>
    </requirement>

    <requirement priority="medium">
      <description>Change cadence: do not force periodic password changes without indication of compromise. Encourage change upon suspicion of compromise.</description>
    </requirement>

    <requirement priority="medium">
      <description>Multi-factor: offer phishing-resistant MFA (e.g., passkeys/WebAuthn) when feasible, especially for privileged accounts.</description>
    </requirement>
  </requirements>

  <references>
    <reference as="dependency" href=".cursor/rules/000-core/002-cursor-rules-creation.mdc" reason="Rule file structure and validation">Cursor rule file creation standards</reference>
    <reference as="context" href="https://pages.nist.gov/800-63-4/sp800-63b.html" reason="NIST SP 800-63B memorized secret requirements">NIST SP 800-63B</reference>
    <reference as="context" href="https://www.usenix.org/system/files/conference/usenixsecurity16/sec16_paper_ur.pdf" reason="Password advice considered harmful (Ur et al.)">Ur et al., USENIX 2016</reference>
    <reference as="context" href="https://research.google/pubs/compromised-credentials/" reason="Compromised credentials risk data (Google Research)">Google Research on compromised credentials</reference>
    <reference as="context" href="https://www.troyhunt.com/introducing-306-million-freely-downloadable-pwned-passwords/" reason="Compromised password corpus (HIBP)">Troy Hunt, Have I Been Pwned</reference>
  </references>
</rule>