  <requirements>
    <non-negotiable priority="critical">
      <description>Use Mastra framework with proper TypeScript configuration, agent registration, and production-ready patterns following official Mastra.ai standards.</description>
      <examples>
        <example title="Complete Mastra Setup with Agents and Server">
          <correct-example title="Production-ready Mastra configuration" conditions="Setting up Mastra instance with agents and server" expected-result="Fully configured Mastra application" correctness-criteria="Uses proper TypeScript config, agent registration, server setup, type safety"><![CDATA[// src/mastra/index.ts - Main Mastra instance configuration
import { Mastra } from "@mastra/core/mastra";
import { testAgent, codeReviewAgent } from "./agents";
import { organizationWorkflow } from "./workflows";

export const mastra = new Mastra({
  // Register agents for application-wide availability
  agents: {
    testAgent,
    codeReviewAgent,
  },

  // Register workflows
  workflows: {
    organizationWorkflow,
  },

  // Server configuration
  server: {
    port: 4111, // Default
    timeout: 180000, // 3 minutes default
    bodyLimit: "10mb",

    // CORS configuration for production
    cors: {
      origin: ["https://example.com", "https://app.example.com"],
      allowMethods: ["GET", "POST", "PUT", "DELETE", "OPTIONS"],
      allowHeaders: ["Content-Type", "Authorization"],
      credentials: true,
    },
  },
});

// src/mastra/agents/test-agent.ts - Basic agent definition
import { Agent } from "@mastra/core/agent";
import { testTool } from "../tools";

export const testAgent = new Agent({
  name: "test-agent",
  instructions: "You are a helpful assistant that organizes tasks and schedules.",
  model: "openai/gpt-4o-mini",
  tools: { testTool },
});

// src/mastra/agents/code-review-agent.ts - Advanced agent with provider options
import { Agent } from "@mastra/core/agent";
import { openai } from "@ai-sdk/openai";

export const codeReviewAgent = new Agent({
  name: "code-review-agent",

  // Complex instructions with provider-specific options
  instructions: [
    {
      role: "system",
      content: "You are an expert code reviewer specializing in TypeScript, React, and Node.js. Focus on: code quality, security vulnerabilities, performance, maintainability, and best practices.",
      providerOptions: {
        openai: { reasoningEffort: "high" },
        anthropic: { cacheControl: { type: "ephemeral" } },
      },
    },
    "When reviewing code, provide specific examples and actionable recommendations.",
    "Rate severity as: critical, high, medium, low, or info.",
  ],

  // Using Vercel AI SDK for direct provider configuration
  model: openai("gpt-4o-mini"),

  // Runtime context for dynamic model selection
  model: ({ runtimeContext }) => {
    const userTier = runtimeContext.get("user-tier");
    return userTier === "enterprise"
      ? openai("gpt-4o")
      : openai("gpt-4o-mini");
  },
});

// src/mastra/tools/test-tool.ts - Tool definition
import { createTool } from "@mastra/core/tool";
import { z } from "zod";

export const testTool = createTool({
  name: "test-tool",
  description: "Formats text with emphasis",
  inputSchema: z.object({
    text: z.string(),
  }),
  outputSchema: z.object({
    emphasized: z.string(),
  }),
  execute: async ({ context, mastra, runtimeContext }) => {
    const formatted = `**${context.text}**`;
    return { emphasized: formatted };
  },
});

// src/mastra/workflows/organization-workflow.ts - Workflow with agents
import { createWorkflow, createStep } from "@mastra/core/workflow";

const step1 = createStep({
  id: "organize-tasks",
  execute: async ({ inputData, mastra }) => {
    const agent = mastra.getAgent("testAgent");

    // Use agent with memory
    const response = await agent.generate(
      `Organize these tasks: ${inputData.tasks}`,
      {
        memory: {
          thread: inputData.userId,
          resource: "task-organization",
        },
        maxSteps: 10,
        onStepFinish: ({ text, toolCalls, toolResults, finishReason, usage }) => {
          console.log("Step completed:", { text, toolCalls, finishReason, usage });
        },
      }
    );

    return { organizedTasks: response.text };
  },
});

// Agent as workflow step
const step2 = createStep(testAgent);

export const organizationWorkflow = createWorkflow({
  name: "organization-workflow",
  triggerSchema: z.object({
    tasks: z.string(),
    userId: z.string(),
  }),
})
  .then(step1)
  .map(async ({ context }) => ({
    prompt: `Create a summary: ${context.organizedTasks}`,
  }))
  .then(step2)
  .commit();

