    <requirement priority="high">
      <description>Integrate agents into workflows with proper step composition, data flow, and orchestration patterns.</description>
      <examples>
        <example title="Workflow Orchestration Patterns">
          <correct-example title="Advanced workflow with agents and tools" conditions="Building complex workflows" expected-result="Well-orchestrated workflow" correctness-criteria="Uses proper step composition, data mapping, error handling"><![CDATA[// src/mastra/workflows/content-pipeline.ts
import { createWorkflow, createStep } from "@mastra/core/workflow";
import { z } from "zod";

// Step 1: Direct agent invocation with control
const analyzeStep = createStep({
  id: "analyze-content",
  execute: async ({ inputData, mastra, runtimeContext }) => {
    const agent = mastra.getAgent("analysisAgent");

    try {
      const response = await agent.generate(
        `Analyze this content: ${inputData.content}`,
        {
          memory: {
            thread: inputData.userId,
            resource: `content-${inputData.contentId}`,
          },
          maxSteps: 10,
          onStepFinish: ({ text, toolCalls, finishReason, usage }) => {
            console.log("Analysis step:", { text, toolCalls, finishReason });
          },
        }
      );

      return {
        analysis: response.text,
        tokenUsage: response.usage,
      };
    } catch (error) {
      console.error("Analysis failed:", error);
      throw error;
    }
  },
});

// Step 2: Tool invocation
const formatStep = createStep({
  id: "format-content",
  execute: async ({ inputData, mastra }) => {
    const tool = mastra.getTool("formatTool");

    const response = await tool.execute({
      context: { text: inputData.analysis },
    });

    return { formatted: response.formatted };
  },
});

// Step 3: Agent as step (simpler composition)
const summaryAgent = mastra.getAgent("summaryAgent");
const summarizeStep = createStep(summaryAgent);

// Complex workflow with branching and parallel execution
export const contentPipeline = createWorkflow({
  name: "content-pipeline",
  triggerSchema: z.object({
    content: z.string(),
    contentId: z.string(),
    userId: z.string(),
    options: z.object({
      includeKeywords: z.boolean(),
      generateSummary: z.boolean(),
    }),
  }),
})
  // Step 1: Analyze content
  .then(analyzeStep)

  // Step 2: Format based on analysis
  .then(formatStep)

  // Step 3: Conditional branching
  .branch({
    when: ({ context }) => context.options.generateSummary,
    then: ({ context }) => ({
      prompt: `Summarize this analysis: ${context.formatted}`,
    }),
  })
  .then(summarizeStep)

  // Step 4: Parallel operations
  .parallel([
    createStep({
      id: "extract-keywords",
      execute: async ({ mastra, context }) => {
        if (!context.options.includeKeywords) {
          return { keywords: [] };
        }

        const agent = mastra.getAgent("keywordAgent");
        const response = await agent.generate(
          `Extract keywords: ${context.formatted}`
        );

        return { keywords: response.text.split(",") };
      },
    }),
    createStep({
      id: "generate-metadata",
      execute: async ({ context }) => {
        return {
          metadata: {
            processedAt: new Date().toISOString(),
            wordCount: context.formatted.split(" ").length,
          },
        };
      },
    }),
  ])

  // Final aggregation
  .then(createStep({
    id: "aggregate-results",
    execute: async ({ context }) => {
      return {
        result: {
          analysis: context.analysis,
          formatted: context.formatted,
          summary: context.summary || null,
          keywords: context.keywords || [],
          metadata: context.metadata,
          tokenUsage: context.tokenUsage,
        },
      };
    },
  }))

  .commit();

// Workflow execution with error handling
export async function executeContentPipeline(input: {
  content: string;
  contentId: string;
  userId: string;
  options: { includeKeywords: boolean; generateSummary: boolean };
}) {
  try {
    const result = await contentPipeline.execute(input);
    console.log("Pipeline completed:", result);
    return result;
  } catch (error) {
    console.error("Pipeline failed:", error);
    throw new Error("Content pipeline execution failed");
  }
}]]></correct-example>

