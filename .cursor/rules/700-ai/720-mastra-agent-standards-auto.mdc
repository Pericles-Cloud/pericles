    <requirement priority="critical">
      <description>Implement agents with proper response handling, streaming, structured output, and error management following Mastra patterns.</description>
      <examples>
        <example title="Advanced Agent Response Patterns">
          <correct-example title="Complete agent response handling" conditions="Implementing agent with various response types" expected-result="Robust agent with proper error handling" correctness-criteria="Uses streaming, structured output, callbacks, error handling"><![CDATA[// src/mastra/agents/analysis-agent.ts
import { Agent } from "@mastra/core/agent";
import { z } from "zod";

export const analysisAgent = new Agent({
  name: "analysis-agent",
  instructions: "You analyze text and provide structured insights.",
  model: "openai/gpt-4o",
});

// Example 1: Standard generation with error handling
export async function analyzeText(text: string) {
  try {
    const response = await analysisAgent.generate([
      { role: "user", content: `Analyze this text: ${text}` },
    ]);

    console.log("Analysis:", response.text);
    console.log("Token usage:", response.usage);

    return response.text;
  } catch (error) {
    console.error("Analysis failed:", error);
    throw new Error("Failed to analyze text");
  }
}

// Example 2: Streaming response for real-time UI
export async function streamAnalysis(text: string) {
  try {
    const stream = await analysisAgent.stream([
      { role: "user", content: `Analyze this text: ${text}` },
    ], {
      onFinish: ({ steps, text, finishReason, usage }) => {
        console.log("Stream completed:", {
          totalSteps: steps.length,
          finalText: text,
          reason: finishReason,
          tokensUsed: usage,
        });
      },
    });

    // Stream to client
    for await (const chunk of stream.textStream) {
      process.stdout.write(chunk);
    }
  } catch (error) {
    console.error("Stream failed:", error);
    throw error;
  }
}

// Example 3: Structured output with validation
export async function getStructuredAnalysis(text: string) {
  const analysisSchema = z.object({
    summary: z.string().describe("Brief summary of the text"),
    sentiment: z.enum(["positive", "negative", "neutral"]),
    keywords: z.array(z.string()).describe("Key topics and themes"),
    actionItems: z.array(z.object({
      task: z.string(),
      priority: z.enum(["high", "medium", "low"]),
    })),
    confidence: z.number().min(0).max(1),
  });

  try {
    const response = await analysisAgent.generate(
      [{ role: "user", content: `Analyze: ${text}` }],
      {
        structuredOutput: {
          schema: analysisSchema,
        },
        maxSteps: 10,
        onStepFinish: ({ text, toolCalls, finishReason, usage }) => {
          console.log("Step:", { text, toolCalls, finishReason, usage });
        },
      }
    );

    // Type-safe structured output
    const analysis = response.object;
    console.log("Summary:", analysis.summary);
    console.log("Sentiment:", analysis.sentiment);
    console.log("Keywords:", analysis.keywords);

    return analysis;
  } catch (error) {
    console.error("Structured analysis failed:", error);
    throw error;
  }
}

// Example 4: Sub-agent for structured output
export async function getEnhancedStructuredAnalysis(text: string) {
  const response = await analysisAgent.generate(
    [{ role: "user", content: text }],
    {
      structuredOutput: {
        schema: z.object({
          summary: z.string(),
          details: z.array(z.string()),
        }),
        model: "openai/gpt-4o", // Use different model for structuring
      },
    }
  );

  return response.object;
}

// Example 5: Image processing
export async function analyzeImage(imageUrl: string) {
  const response = await analysisAgent.generate([
    {
      role: "user",
      content: [
        {
          type: "image",
          image: imageUrl,
          mimeType: "image/jpeg",
        },
        {
          type: "text",
          text: "Describe this image in detail, focusing on key elements and context.",
        },
      ],
    },
  ]);

  return response.text;
}

// Example 6: Multi-turn conversation
export async function conversationalAnalysis(messages: Array<{ role: string; content: string }>) {
  const response = await analysisAgent.generate(messages, {
    memory: {
      thread: "analysis-session-123",
      resource: "document-456",
    },
    maxSteps: 15,
  });

  return response.text;
}]]></correct-example>

