# =============================================================================
# PERICLES - Unified Environment Configuration
# =============================================================================
# Copy this file to .env.local and fill in your values.
# This file is committed to version control - DO NOT add secrets here.

# =============================================================================
# Database Configuration
# =============================================================================
DATABASE_URL="postgresql://pericles_user:pericles_dev_password@localhost:5432/pericles?schema=public"
MASTRA_DATABASE_URL="postgresql://pericles_user:pericles_dev_password@localhost:5432/mastra?schema=public"

# =============================================================================
# AI Model Provider API Keys
# =============================================================================
# OpenAI (GPT-4o, GPT-4, GPT-3.5) - https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key

# Google AI (Gemini) - https://aistudio.google.com/app/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_GEMINI_API_KEY=
GEMINI_API_KEY=

# DeepSeek - https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# Anthropic - https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Neon (optional) - https://neon.tech/
NEON_API_KEY=

# =============================================================================
# Google APIs
# =============================================================================
GOOGLE_APPLICATION_CREDENTIALS=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# =============================================================================
# Data Source APIs (Monitoring Tools)
# =============================================================================
# News API - https://thenewsapi.com/
THENEWSAPI_API_KEY=

# Twitter/X API - https://developer.twitter.com/
TWITTERAPIIO_API_KEY=

# OpenWeather API - https://openweathermap.org/api
OPENWEATHER_API_KEY=

# Reddit API - https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Marine Traffic API - https://www.marinetraffic.com/en/ais-api-services
MARINETRAFFIC_API_KEY=

# =============================================================================
# Message Queue (optional - uses PostgreSQL by default)
# =============================================================================
REDIS_URL=redis://localhost:6379

# =============================================================================
# SAP S/4HANA Cloud Integration
# =============================================================================
SAP_S4HANA_BASE_URL=https://mock-sap.s4hana.ondemand.com
SAP_S4HANA_CLIENT_ID=mock-client-id
SAP_S4HANA_CLIENT_SECRET=mock-client-secret
SAP_S4HANA_TIMEOUT=30000
SAP_S4HANA_USE_MOCK=true

# =============================================================================
# Monitoring Configuration
# =============================================================================
MONITORING_DEFAULT_INTERVAL_MS=15000
MONITORING_API_TOKEN=your-secure-token-here
LOG_LEVEL=info
ENABLE_TRACING=true

# =============================================================================
# Authentication Configuration
# =============================================================================
# Generate with: openssl rand -hex 32
JWT_SECRET=your-jwt-secret-here
JWT_REFRESH_SECRET=your-jwt-refresh-secret-here
JWT_ACCESS_TTL=24h
JWT_REFRESH_TTL=7d

# =============================================================================
# Google OAuth (optional - for Google SSO)
# =============================================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4112/api/auth/google/callback

# =============================================================================
# Frontend Configuration
# =============================================================================
# The auth-server runs on port 4112 and handles auth + organization APIs
NEXT_PUBLIC_API_URL=http://localhost:4112
