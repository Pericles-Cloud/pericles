.env*~
.env*.bak

# Local patch staging
/patch/

# IDE
.idea/
*.swp
*.swo
.vscode/

# OS
**/.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Testing
coverage/
test-results.xml

# Archives
*.zip

# Misc
*.tgz
.turbo
.vercel

backups/
# Python
__pycache__/
*.pyc

# Personal Obsidian vault + the symlinks the claude-obsidian hooks resolve.
# MUST stay ignored: the plugin's PostToolUse hook runs
#   git add -- wiki/ .raw/ .vault-meta/ && git commit
# on every Write/Edit, so un-ignoring these auto-commits personal notes into
# this shared repo.
Pericles-Wiki/
wiki
.vault-meta
.raw
